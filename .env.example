# Copy to .env (never committed). Docker Compose reads it for both services.

# Flask: only needed for the "Get AI Explanation" button
OPENAI_API_KEY=your_key_here

# Web: Find care map. Unlike the other keys this one has to reach the browser
# (Google's map script loads there), so it can never be fully hidden -- lock it
# down in Google Cloud instead: Credentials -> your key -> Application
# restrictions "Websites" (your site's URL only) + API restrictions "Maps
# JavaScript API" only. A key restricted this way is useless if copied.
GoogleMaps__ApiKey=your_google_maps_key_here

# Web: Sign in with Google (OAuth client of type "Web application")
Authentication__Google__ClientId=your_client_id.apps.googleusercontent.com
Authentication__Google__ClientSecret=your_client_secret

# Shared secret the web app presents to Flask alongside the user id.
# Any long random string, e.g. from:  openssl rand -base64 32
SKINCHECK_INTERNAL_KEY=change_me_to_a_long_random_string

# Web: telehealth scheduling. The Google account for each email below gets a
# provider dashboard on sign-in instead of the ordinary patient account. Not a
# secret, but comma-separated -- keep it out of source control anyway since
# it's environment-specific. Leave unset and nobody gets a provider account.
# Provider__AllowedEmails=doctor1@example.com,doctor2@example.com

# Deployment only (ignore for local use)
# The hostname(s) the site is served on; requests for any other Host are rejected.
# AllowedHosts=your.domain.example
# If a reverse proxy (nginx, Caddy, a cloud load balancer) sits in front of the web
# container, name its address so per-visitor rate limits use the real client
# address instead of the proxy's. Use the network the proxy's container is on.
# ReverseProxy__KnownNetworks__0=172.18.0.0/16
