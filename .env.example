# Copy to .env (never committed). Docker Compose reads it for both services.

# Flask: only needed for the "Get AI Explanation" button
OPENAI_API_KEY=your_key_here

# Web: Find care map
GoogleMaps__ApiKey=your_google_maps_key_here

# Web: Sign in with Google (OAuth client of type "Web application")
Authentication__Google__ClientId=your_client_id.apps.googleusercontent.com
Authentication__Google__ClientSecret=your_client_secret

# Shared secret the web app presents to Flask alongside the user id.
# Any long random string, e.g. from:  openssl rand -base64 32
SKINCHECK_INTERNAL_KEY=change_me_to_a_long_random_string
