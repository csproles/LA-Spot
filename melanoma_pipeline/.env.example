# Copy this file to `.env` and fill in real values for your device. `.env`
# itself is gitignored (never commit real paths from a personal machine
# unless you want them public) -- only this `.env.example` template is
# tracked. config.py reads these via `os.environ.get(...)`, falling back to
# the relative-path defaults shown here if a variable is unset, so setting
# `.env` is optional but recommended so you don't have to edit config.py.
#
# How to load this file: this package does not force a specific env-loader
# (no python-dotenv dependency added). Either:
#   - `pip install python-dotenv` and add `from dotenv import load_dotenv;
#     load_dotenv()` at the top of whichever script you run, or
#   - export these as real shell environment variables before running
#     anything (e.g. `export MELANOMA_DATA_DIR=/mnt/data/isic2024` on
#     Linux/macOS, `$env:MELANOMA_DATA_DIR="D:\isic2024"` in PowerShell), or
#   - just edit the defaults directly in config.py if you prefer not to use
#     environment variables at all -- both are equally supported.

# ---- Required: where the ISIC 2024 dataset lives on THIS device --------
# See README.md section 5a ("External assets") for how to get this data in
# the first place -- it is NOT included in this repository.
MELANOMA_DATA_DIR=data
MELANOMA_IMAGE_DIR=data/images
MELANOMA_METADATA_CSV=data/metadata.csv

# ---- Optional: where this pipeline writes checkpoints/embeddings/models --
MELANOMA_OUTPUT_DIR=outputs
MELANOMA_CHECKPOINT_DIR=outputs/checkpoints
MELANOMA_EMBEDDING_DIR=outputs/embeddings

# ---- Required: the YOLO segmentation checkpoint -------------------------
# NOT included in this branch (excluded as a large binary) -- see README.md's
# "External assets" section for exactly how to obtain it. Defaults to
# weights/yolo_melanoma_seg.pt (relative to this directory) if unset -- only
# set this if you're placing the checkpoint somewhere else instead.
# YOLO_WEIGHTS_PATH=/path/to/your/yolo_melanoma_seg.pt

# ---- Optional: training hyperparameter overrides -------------------------
# MELANOMA_N_FOLDS=5
# MELANOMA_SEED=42
# MELANOMA_BATCH_SIZE=8
# MELANOMA_EPOCHS=10
# MELANOMA_PCA_N_COMPONENTS=128
