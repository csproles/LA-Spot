@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager
@inject ChatPageContext ChatPageContext

<PageTitle>Home - LA Spot</PageTitle>

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-greeting">
        <p class="home-hero-eyebrow">@Today</p>
        <h1 id="home-greeting" class="home-hero-title">@Greeting</h1>
        <p class="home-hero-summary">@Summary</p>
        <a href="/check" class="btn home-hero-cta">
            <AppIcon Name="camera" Size="lg" StrokeWidth="2" />
            Check a spot
        </a>
        <span class="home-hero-dog" aria-hidden="true"></span>
    </section>

    <ErrorAlert Message="@LoadError" />

    @if (LoadError is null)
    {
        @if (!IsLoading && !Profile.Configured)
        {
            <RiskProfilePromptCard />
        }

        @if (!IsLoading && Spots.Count == 0)
        {
            <EmptyState Title="Start tracking your first spot"
                        Description="Photograph a mole or spot you want to keep an eye on. Each spot gets its own timeline, so the next time you photograph it we can show you what changed." />
        }
        else
        {
            @if (DueSpots.Count > 0)
            {
                <DueSpotsSection Spots="DueSpots" />
            }

            <div class="home-grid">
                <BodyMapPanel Title="Where you're tracking" Spots="Spots" IsLoading="IsLoading"
                              SelectedRegionChanged="GoToRegion">
                    <Trailing>
                        <a href="/spots" class="link-button">All spots</a>
                    </Trailing>
                    <Footer>
                        Tap an area to see the spots there. A dot's color shows the highest risk in that area: green is low, amber is some, red is high.
                    </Footer>
                </BodyMapPanel>

                <RecentChecksPanel Checks="RecentChecks" IsLoading="IsLoading" />
            </div>
        }
    }

    <MedicalDisclaimer Message="LA Spot gives a preliminary read to help you monitor between appointments. It is not a diagnosis. See a dermatologist about any spot that concerns you." />
</div>

@code {
    private List<Spot> Spots = new();
    private List<HistoryEntry> RecentChecks = new();
    private RiskProfile Profile = new();
    private bool IsLoading = true;
    private string? LoadError;

    private static string Today => AppClock.Now.ToString("dddd, MMMM d").ToUpperInvariant();

    private List<Spot> DueSpots => Spots
        .Where(spot => spot.IsDue)
        .OrderByDescending(spot => spot.LastRiskScore ?? 0)
        .ToList();

    private static string Greeting => AppClock.Greeting;

    private string Summary
    {
        get
        {
            if (IsLoading || LoadError is not null || Spots.Count == 0)
            {
                return "Take a photo of a spot on your skin. We'll measure it and tell you, in plain words, if it's worth showing a doctor.";
            }
            return DueSpots.Count switch
            {
                0 => "You're all caught up. No spot needs a new photo right now.",
                1 => "One spot is ready for a new photo.",
                var due => $"{due} spots are ready for a new photo.",
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var spotsTask = ImageProcessingService.GetSpotsAsync();
            var historyTask = ImageProcessingService.GetHistoryAsync();
            var profileTask = ImageProcessingService.GetProfileAsync();
            await Task.WhenAll(spotsTask, historyTask, profileTask);

            Spots = spotsTask.Result;
            RecentChecks = historyTask.Result.Take(4).ToList();
            Profile = profileTask.Result;
            SetChatContext();
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>Lets the chat widget answer questions about the dashboard the person is looking at.</summary>
    private void SetChatContext()
    {
        ChatPageContext.Set("home", new Dictionary<string, object?>
        {
            ["totalSpots"] = Spots.Count,
            ["dueSpots"] = DueSpots.Count,
            ["recentChecksShown"] = RecentChecks.Count,
            ["profileConfigured"] = Profile.Configured,
        });
    }

    private void GoToRegion(string region) =>
        NavigationManager.NavigateTo($"/spots?region={Uri.EscapeDataString(region)}");

    public void Dispose() => ChatPageContext.Clear();
}
