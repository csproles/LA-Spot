@page "/spots"
@rendermode InteractiveServer
@implements IDisposable
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager
@inject ChatPageContext ChatPageContext

<PageTitle>Spots - LA Spot</PageTitle>

<div class="spots-page">
    <PageHeader Title="My spots">
        <Details>
            @if (IsLoading)
            {
                <SkeletonBlock Width="200px" Height="13px" />
            }
            else
            {
                <span>@AllSpots.Count tracked · @DueCount due for recheck</span>
            }
        </Details>
        <Actions>
            <a href="/check" class="btn btn-primary">New skin check</a>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(Archived))
    {
        <FormFeedback Value="@(new FormFeedback.Feedback($"\u201c{Archived}\u201d was archived. It no longer appears here or in rechecks."))" />
    }

    <ErrorAlert Message="@LoadError" />

    @if (LoadError is null)
    {
        @if (!IsLoading && AllSpots.Count == 0)
        {
            <EmptyState Title="Nothing tracked yet"
                        Description="A spot is a mole or mark you want to keep an eye on. Photograph it once to start its timeline; every later photo of the same spot gets compared against the last."
                        ActionHref="/check"
                        ActionText="Photograph your first spot" />
        }
        else
        {
            <div class="spots-layout">
                <BodyMapPanel Title="Body map" Spots="AllSpots" IsLoading="IsLoading"
                              SelectedRegion="@SelectedRegion" SelectedRegionChanged="ToggleRegion">
                    <Footer>
                        @if (SelectedRegion is not null)
                        {
                            <button type="button" class="link-button" @onclick="() => ToggleRegion(SelectedRegion)">
                                Show all regions
                            </button>
                        }
                        else
                        {
                            <span>Tap a region to filter the list.</span>
                        }
                    </Footer>
                </BodyMapPanel>

                <section class="spots-list-section">
                    <SpotListToolbar Title="@(SelectedRegion ?? "All spots")"
                                     Count="VisibleSpots.Count"
                                     @bind-SortBy="SortBy" />
                    <SpotList Spots="VisibleSpots" IsLoading="IsLoading" SkeletonCount="4"
                              EmptyMessage="No spots tracked in this region yet." />
                </section>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Archived { get; set; }

    [SupplyParameterFromQuery(Name = "region")]
    public string? RegionQuery { get; set; }

    private List<Spot> AllSpots = new();
    private bool IsLoading = true;
    private string? LoadError;
    private string? SelectedRegion;
    private string SortBy = "due";

    private int DueCount => AllSpots.Count(spot => spot.IsDue);

    private List<Spot> VisibleSpots
    {
        get
        {
            var filtered = SelectedRegion is null
                ? AllSpots
                : AllSpots.Where(spot => spot.BodyRegion == SelectedRegion);

            return (SortBy switch
            {
                "risk" => filtered.OrderByDescending(spot => spot.LastRiskScore ?? -1),
                "recent" => filtered.OrderByDescending(spot => spot.LastCheckedAt ?? DateTimeOffset.MinValue),
                _ => filtered
                    .OrderByDescending(spot => spot.IsDue)
                    .ThenBy(spot => spot.NextDueAt ?? DateTimeOffset.MaxValue),
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AllSpots = await ImageProcessingService.GetSpotsAsync();
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
        SetChatContext();
    }

    protected override void OnParametersSet()
    {
        SelectedRegion = string.IsNullOrWhiteSpace(RegionQuery) ? null : RegionQuery;
        SetChatContext();
    }

    /// <summary>Lets the chat widget answer questions about the spots list the person is looking at.</summary>
    private void SetChatContext()
    {
        ChatPageContext.Set("spots", new Dictionary<string, object?>
        {
            ["totalSpots"] = AllSpots.Count,
            ["dueSpots"] = DueCount,
            ["selectedRegion"] = SelectedRegion,
        });
    }

    private void ToggleRegion(string region)
    {
        var next = SelectedRegion == region ? null : region;
        NavigationManager.NavigateTo(next is null ? "/spots" : $"/spots?region={Uri.EscapeDataString(next)}");
    }

    public void Dispose() => ChatPageContext.Clear();
}
