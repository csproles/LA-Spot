@page "/check"
@rendermode InteractiveServer
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager

<PageTitle>New Skin Check - Skin Check</PageTitle>

<div class="check-page">
    <PageHeader Eyebrow="@Today" Title="@StepTitle" Subtitle="@StepSubtitle" Size="lg" />

    <CheckStepper CurrentStep="CurrentStep" />

    <ErrorAlert Message="@ErrorMessage" />

    @switch (CurrentStep)
    {
        case CheckStep.Spot:
            <SpotSelectionStep Spots="Spots" IsLoading="IsLoadingSpots" IsSaving="IsSaving"
                               CreateSpot="CreateSpot" OnSpotChosen="StartCapture" />
            break;

        case CheckStep.Capture:
            <CaptureStep IsRecheck="@(SelectedSpot?.CheckCount > 0)" RetakeHint="@RetakeHint"
                         OnFileSelected="HandleFileSelected"
                         OnPhotoCaptured="HandlePhotoCaptured"
                         OnChangeSpot="() => CurrentStep = CheckStep.Spot" />
            break;

        case CheckStep.Confirm:
            <PhotoConfirmStep PreviewDataUrl="@PreviewDataUrl" FileName="@SelectedFileName"
                              FileSize="SelectedFileSize" IsAnalyzing="IsAnalyzing"
                              OnConfirm="AnalyzeImage" OnRetake="RetakePhoto" />
            break;

        case CheckStep.Outline when AnalysisResults is not null:
            <OutlineConfirmStep BorderVisual="@AnalysisResults.BorderVisual"
                                OnAccept="() => CurrentStep = CheckStep.Details"
                                OnReject="RejectOutline" />
            break;

        case CheckStep.Details:
            <CheckDetailsStep PreviewDataUrl="@PreviewDataUrl" Spot="SelectedSpot" FileName="@SelectedFileName"
                              Symptoms="SelectedSymptoms" @bind-Notes="Notes"
                              OnRetake="RetakePhoto"
                              OnContinue="() => CurrentStep = CheckStep.Results" />
            break;

        case CheckStep.Results when AnalysisResults is not null:
            <CheckResultsStep Results="AnalysisResults" ProcessingId="@CurrentProcessingId"
                              IsSaving="IsSaving" IsSaved="IsSaved"
                              OnSave="SaveToHistory" OnStartAnother="StartNewCheck" />
            break;
    }

    <MedicalDisclaimer />
</div>

@code {
    [SupplyParameterFromQuery(Name = "spot")]
    public string? SpotQuery { get; set; }

    private const long MaxFileSizeBytes = InputLimits.ImageMaxBytes;

    private static readonly HashSet<string> AllowedContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/jpg", "image/png", "image/bmp", "image/webp"
    };

    private static string Today => DateTime.Now.ToString("dddd, MMMM d, yyyy").ToUpperInvariant();

    private CheckStep CurrentStep = CheckStep.Spot;
    private string? ErrorMessage;

    private List<Spot> Spots = new();
    private bool IsLoadingSpots = true;
    private Spot? SelectedSpot;

    private string? PreviewDataUrl;
    private string? SelectedFileName;
    private long SelectedFileSize;
    private byte[]? SelectedFileBytes;

    private HashSet<string> SelectedSymptoms = new();
    private string Notes = string.Empty;

    private bool IsAnalyzing;
    private bool IsSaving;
    private bool IsSaved;
    private string CurrentProcessingId = string.Empty;
    private ImageProcessingResults? AnalysisResults;
    private string? RetakeHint;

    private string StepTitle => CurrentStep switch
    {
        CheckStep.Spot => "Which spot?",
        CheckStep.Capture => SelectedSpot?.CheckCount > 0
            ? $"Re-check \"{SelectedSpot.Label}\""
            : $"Photograph \"{SelectedSpot?.Label}\"",
        CheckStep.Confirm => IsAnalyzing ? "One moment" : "Check the photo",
        CheckStep.Outline => "Check the outline",
        CheckStep.Details => "Add details",
        _ => "Your results",
    };

    private string StepSubtitle => CurrentStep switch
    {
        CheckStep.Spot => "Every photo is filed under a spot so we can show you how it changes over time.",
        CheckStep.Capture => "A good photo is most of the accuracy. Two minutes here pays off.",
        CheckStep.Confirm => IsAnalyzing
            ? "Measuring the spot in your photo."
            : "Make sure the spot is sharp and centred before we analyze it.",
        CheckStep.Outline => "We've found what we think is the lesion. You know the spot better than we do.",
        CheckStep.Details => "Optional, but symptoms and notes are saved with the check.",
        _ => "A preliminary read in under a minute.",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Spots = await ImageProcessingService.GetSpotsAsync();
        }
        catch (ImageProcessingApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoadingSpots = false;
        }

        if (!string.IsNullOrWhiteSpace(SpotQuery))
        {
            SelectedSpot = Spots.FirstOrDefault(spot => spot.Id == SpotQuery);
            if (SelectedSpot is not null)
            {
                CurrentStep = CheckStep.Capture;
            }
        }
    }

    private async Task<Spot?> CreateSpot(string label, string region)
    {
        ErrorMessage = null;
        IsSaving = true;
        try
        {
            var created = await ImageProcessingService.CreateSpotAsync(label, region);
            Spots.Insert(0, created);
            return created;
        }
        catch (ImageProcessingApiException ex)
        {
            ErrorMessage = ex.Message;
            return null;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void StartCapture(Spot spot)
    {
        SelectedSpot = spot;
        ErrorMessage = null;
        CurrentStep = CheckStep.Capture;
    }

    private void RetakePhoto()
    {
        PreviewDataUrl = null;
        SelectedFileName = null;
        SelectedFileBytes = null;
        AnalysisResults = null;
        CurrentProcessingId = string.Empty;
        CurrentStep = CheckStep.Capture;
    }

    private void RejectOutline()
    {
        RetakeHint = "The outline didn't match, so that photo was discarded. Try again with the spot centred, "
            + "sharply in focus, and with even light — the outline usually drifts when the edge is soft or shadowed.";
        RetakePhoto();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        RetakeHint = null;
        PreviewDataUrl = null;

        var file = e.File;

        if (!AllowedContentTypes.Contains(file.ContentType))
        {
            ErrorMessage = $"Unsupported file type '{file.ContentType}'. Please upload a JPEG, PNG, BMP, or WebP image.";
            return;
        }

        if (file.Size == 0)
        {
            ErrorMessage = "The selected file is empty.";
            return;
        }

        if (file.Size > MaxFileSizeBytes)
        {
            ErrorMessage = $"File is too large ({file.Size / (1024.0 * 1024.0):F2} MB). Maximum allowed size is 5 MB.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSizeBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            AcceptImage(memoryStream.ToArray(), file.ContentType, file.Name);
        }
        catch (IOException)
        {
            ErrorMessage = "File is too large to read. Maximum allowed size is 5 MB.";
        }
    }

    /// <summary>A JPEG frame from the in-app camera viewfinder (<see cref="CameraCapture"/>).</summary>
    private void HandlePhotoCaptured(byte[] bytes)
    {
        ErrorMessage = null;
        RetakeHint = null;
        PreviewDataUrl = null;

        if (bytes.Length == 0)
        {
            ErrorMessage = "The camera didn't return a photo. Please try again.";
            return;
        }

        if (bytes.Length > MaxFileSizeBytes)
        {
            ErrorMessage = $"Captured photo is too large ({bytes.Length / (1024.0 * 1024.0):F2} MB). Maximum allowed size is 5 MB.";
            return;
        }

        AcceptImage(bytes, "image/jpeg", $"camera-capture-{DateTime.Now:yyyyMMdd-HHmmss}.jpg");
    }

    private void AcceptImage(byte[] bytes, string contentType, string fileName)
    {
        // The browser's declared type is only a claim; make sure the bytes really are a photo.
        if (!InputLimits.LooksLikeImage(bytes))
        {
            ErrorMessage = "That file doesn't look like a photo. Please choose a JPEG, PNG, BMP, or WebP image.";
            return;
        }

        SelectedFileBytes = bytes;
        PreviewDataUrl = $"data:{contentType};base64,{Convert.ToBase64String(bytes)}";
        SelectedFileName = fileName;
        SelectedFileSize = bytes.Length;
        CurrentStep = CheckStep.Confirm;
    }

    private async Task AnalyzeImage()
    {
        if (SelectedFileBytes is null || SelectedFileName is null || SelectedSpot is null)
        {
            return;
        }

        IsAnalyzing = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await ImageProcessingService.ProcessImageAsync(
                SelectedFileBytes, SelectedFileName, SelectedSpot.Id, SelectedSpot.BodyRegion);
            CurrentProcessingId = response.ProcessingId;
            AnalysisResults = await ImageProcessingService.GetResultsAsync(response.ProcessingId);
            CurrentStep = CheckStep.Outline;
        }
        catch (ImageProcessingApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsAnalyzing = false;
        }
    }

    private async Task SaveToHistory()
    {
        if (string.IsNullOrEmpty(CurrentProcessingId))
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            await ImageProcessingService.SaveToHistoryAsync(CurrentProcessingId, SelectedSymptoms, Notes);
            IsSaved = true;
        }
        catch (ImageProcessingApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void StartNewCheck()
    {
        ErrorMessage = null;
        PreviewDataUrl = null;
        SelectedFileName = null;
        SelectedFileBytes = null;
        SelectedSpot = null;
        SelectedSymptoms = new HashSet<string>();
        Notes = string.Empty;
        AnalysisResults = null;
        CurrentProcessingId = string.Empty;
        IsSaved = false;
        RetakeHint = null;
        CurrentStep = CheckStep.Spot;
        NavigationManager.NavigateTo("/check");
    }
}
