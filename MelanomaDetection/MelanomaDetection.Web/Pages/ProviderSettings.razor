@page "/provider/settings"
@rendermode InteractiveServer
@inject AvailabilityService Availability
@inject CurrentUser CurrentUser

<PageTitle>Provider settings - LA Spot</PageTitle>

@if (!IsInitialized)
{
    <SkeletonBlock Height="200px" Shape="card" />
}
else if (!IsProvider)
{
    <EmptyState Title="Provider accounts only" Description="This page is for dermatologist accounts." ActionHref="/" ActionText="Go home" />
}
else
{
    <div class="provider-page">
        <PageHeader Title="Hours & profile" Subtitle="Your profile, visit length and the hours patients can book.">
            <Actions>
                <a href="/provider" class="btn btn-outline-primary">Back to schedule</a>
            </Actions>
        </PageHeader>

        <BookableSummary OpenSlots="OpenSlots" IsLoading="IsLoadingSummary" HasWeeklyHours="Rules.Count > 0"
                         DaysAhead="SummaryDays" TimeZoneId="@SavedTimeZoneId" TimeZoneLabel="@TimeZoneLabel(SavedTimeZoneId)" />

        <section class="card-panel">
            <h2 class="panel-title">Weekly hours</h2>
            <p class="text-muted-small">Repeats every week. Times are in @TimeZoneLabel(SavedTimeZoneId).</p>
            @if (Rules.Count == 0)
            {
                <p class="text-muted-small">No weekly hours yet -- patients won't see any open times.</p>
            }
            else
            {
                <ul class="rule-list">
                    @foreach (var rule in Rules)
                    {
                        var visits = VisitsIn(rule.StartTime, rule.EndTime);
                        <li class="rule-row">
                            <span class="rule-row-main">
                                <strong>@rule.Weekday</strong> @rule.StartTime.ToString("h:mm tt") - @rule.EndTime.ToString("h:mm tt")
                                <span class="rule-row-count @(visits == 0 ? "is-warn" : "")">
                                    @(visits == 0 ? $"too short for a {SavedLengthMinutes}-min visit" : $"{visits} visit{(visits == 1 ? "" : "s")}")
                                </span>
                            </span>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@RemovingRuleIds.Contains(rule.Id)"
                                    aria-label="@($"Remove {rule.Weekday} {rule.StartTime:h:mm tt} to {rule.EndTime:h:mm tt}")"
                                    @onclick="() => RemoveRuleAsync(rule)">
                                @if (RemovingRuleIds.Contains(rule.Id))
                                {
                                    <span class="btn-spinner" aria-hidden="true"></span>
                                }
                                Remove
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="provider-form-grid">
                <label class="provider-field">
                    Day
                    <select class="form-select" @bind="NewRuleWeekday">
                        @foreach (var day in Weekdays)
                        {
                            <option value="@day">@day</option>
                        }
                    </select>
                </label>
                <label class="provider-field">
                    From
                    <input type="time" class="form-control" @bind="NewRuleStart" @bind:event="oninput" />
                </label>
                <label class="provider-field">
                    To
                    <input type="time" class="form-control" @bind="NewRuleEnd" @bind:event="oninput" />
                </label>
            </div>
            <p class="provider-hint @(NewRuleProblem is null ? "" : "is-warn")">@(NewRuleProblem ?? NewRulePreview)</p>
            <div class="provider-actions">
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(IsAddingRule || NewRuleProblem is not null)" @onclick="AddRuleAsync">
                    @if (IsAddingRule)
                    {
                        <span class="btn-spinner" aria-hidden="true"></span>
                    }
                    Add hours
                </button>
            </div>
            <FormFeedback Value="RulesFeedback" />
        </section>

        <section class="card-panel">
            <h2 class="panel-title">Blocked dates &amp; extra hours</h2>
            @if (Exceptions.Count == 0)
            {
                <p class="text-muted-small">No changes to your weekly hours.</p>
            }
            else
            {
                <ul class="rule-list">
                    @foreach (var ex in Exceptions)
                    {
                        <li class="rule-row">
                            <span class="rule-row-main"><strong>@ex.Date.ToString("ddd, MMM d")</strong> @DescribeException(ex)</span>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@RemovingExceptionIds.Contains(ex.Id)"
                                    @onclick="() => RemoveExceptionAsync(ex)">
                                @if (RemovingExceptionIds.Contains(ex.Id))
                                {
                                    <span class="btn-spinner" aria-hidden="true"></span>
                                }
                                Remove
                            </button>
                        </li>
                    }
                </ul>
            }

            <SegmentedControl Options="ExceptionTypeOptions" @bind-Value="NewExceptionType" AriaLabel="Exception type" />
            <div class="provider-form-grid">
                <label class="provider-field">
                    Date
                    <input type="date" class="form-control" min="@ProviderToday.ToString("yyyy-MM-dd")" @bind="NewExceptionDate" @bind:event="oninput" />
                </label>
                @if (NewExceptionType != "block-day")
                {
                    <label class="provider-field">
                        From
                        <input type="time" class="form-control" @bind="NewExceptionStart" @bind:event="oninput" />
                    </label>
                    <label class="provider-field">
                        To
                        <input type="time" class="form-control" @bind="NewExceptionEnd" @bind:event="oninput" />
                    </label>
                }
            </div>
            @if (NewExceptionProblem is not null)
            {
                <p class="provider-hint is-warn">@NewExceptionProblem</p>
            }
            <div class="provider-actions">
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(IsAddingException || NewExceptionProblem is not null)" @onclick="AddExceptionAsync">
                    @if (IsAddingException)
                    {
                        <span class="btn-spinner" aria-hidden="true"></span>
                    }
                    Add
                </button>
            </div>
            <FormFeedback Value="ExceptionsFeedback" />
        </section>

        <section class="card-panel">
            <h2 class="panel-title">Visit settings</h2>
            <div class="provider-form-grid">
                <label class="provider-field">
                    Visit length (minutes)
                    <input type="number" class="form-control" min="5" max="240" step="5" @bind="SettingsLengthMinutes" />
                </label>
                <label class="provider-field">
                    Buffer between visits (minutes)
                    <input type="number" class="form-control" min="0" max="120" step="5" @bind="SettingsBufferMinutes" />
                </label>
                <label class="provider-field">
                    Timezone
                    <select class="form-select" @bind="SettingsTimeZoneId">
                        @foreach (var tz in CommonTimeZones)
                        {
                            <option value="@tz.Id">@tz.Label</option>
                        }
                    </select>
                </label>
            </div>
            <div class="provider-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@IsSavingSettings" @onclick="SaveSettingsAsync">
                    @if (IsSavingSettings)
                    {
                        <span class="btn-spinner" aria-hidden="true"></span>
                    }
                    Save settings
                </button>
            </div>
            <FormFeedback Value="SettingsFeedback" />
        </section>

        <section class="card-panel">
            <h2 class="panel-title">Your profile</h2>
            <p class="text-muted-small">What patients see when browsing dermatologists. Self-reported -- not verified against a licensing board.</p>
            <div class="provider-form-grid">
                <label class="provider-field">
                    Specialty
                    <input type="text" class="form-control" maxlength="100" @bind="ProfileSpecialty" />
                </label>
                <label class="provider-field">
                    License #
                    <input type="text" class="form-control" maxlength="50" @bind="ProfileLicenseNumber" />
                </label>
                <label class="provider-field">
                    Credentials
                    <input type="text" class="form-control" maxlength="200" placeholder="MD, Board-Certified Dermatologist" @bind="ProfileCredentials" />
                </label>
                <label class="provider-field">
                    Photo URL
                    <input type="text" class="form-control" maxlength="2048" placeholder="https://..." @bind="ProfilePhotoUrl" />
                </label>
            </div>
            <label class="provider-field">
                Bio
                <textarea class="form-control" rows="3" maxlength="2000" @bind="ProfileBio"></textarea>
            </label>
            <div class="provider-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@IsSavingProfile" @onclick="SaveProfileAsync">
                    @if (IsSavingProfile)
                    {
                        <span class="btn-spinner" aria-hidden="true"></span>
                    }
                    Save profile
                </button>
            </div>
            <FormFeedback Value="ProfileFeedback" />
        </section>
    </div>
}

@code {
    private const int SummaryDays = 14;

    private static readonly DayOfWeek[] Weekdays =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private static readonly (string Id, string Label)[] CommonTimeZones =
    [
        ("America/Chicago", "Central (Louisiana)"),
        ("America/New_York", "Eastern"),
        ("America/Denver", "Mountain"),
        ("America/Los_Angeles", "Pacific"),
        ("America/Anchorage", "Alaska"),
        ("Pacific/Honolulu", "Hawaii"),
        ("UTC", "UTC"),
    ];

    private static readonly SegmentedControl.Option[] ExceptionTypeOptions =
    [
        new("block-day", "Block whole day"),
        new("block-hours", "Block some hours"),
        new("open-hours", "Add extra hours"),
    ];

    private bool IsInitialized;
    private bool IsProvider;
    private Guid ProviderId;

    private int SettingsLengthMinutes = 30;
    private int SettingsBufferMinutes = 10;
    private string SettingsTimeZoneId = "America/Chicago";
    private bool IsSavingSettings;
    private FormFeedback.Feedback? SettingsFeedback;

    // What slot counts and the summary are computed from -- only changes on a successful save.
    private int SavedLengthMinutes = 30;
    private int SavedBufferMinutes = 10;
    private string SavedTimeZoneId = "America/Chicago";

    private string ProfileSpecialty = "Dermatology";
    private string? ProfileLicenseNumber;
    private string? ProfileCredentials;
    private string? ProfileBio;
    private string? ProfilePhotoUrl;
    private bool IsSavingProfile;
    private FormFeedback.Feedback? ProfileFeedback;

    private List<AvailabilityRule> Rules = [];
    private DayOfWeek NewRuleWeekday = DayOfWeek.Monday;
    private TimeOnly NewRuleStart = new(9, 0);
    private TimeOnly NewRuleEnd = new(17, 0);
    private bool IsAddingRule;
    private readonly HashSet<int> RemovingRuleIds = [];
    private FormFeedback.Feedback? RulesFeedback;

    private List<AvailabilityException> Exceptions = [];
    private string NewExceptionType = "block-day";
    private DateOnly NewExceptionDate;
    private TimeOnly NewExceptionStart = new(9, 0);
    private TimeOnly NewExceptionEnd = new(12, 0);
    private bool IsAddingException;
    private readonly HashSet<int> RemovingExceptionIds = [];
    private FormFeedback.Feedback? ExceptionsFeedback;

    private IReadOnlyList<DateTime> OpenSlots = [];
    private bool IsLoadingSummary = true;

    private DateOnly ProviderToday => DateOnly.FromDateTime(ClientTimeZone.ToLocal(DateTime.UtcNow, SavedTimeZoneId));

    private string? NewRuleProblem =>
        NewRuleStart >= NewRuleEnd ? "End time must be after the start time."
        : Rules.FirstOrDefault(r => r.Weekday == NewRuleWeekday && r.StartTime < NewRuleEnd && NewRuleStart < r.EndTime) is { } clash
            ? $"Overlaps your {clash.Weekday} hours ({clash.StartTime:h:mm tt} - {clash.EndTime:h:mm tt})."
        : VisitsIn(NewRuleStart, NewRuleEnd) == 0 ? $"Too short to fit a {SavedLengthMinutes}-minute visit."
        : null;

    private string NewRulePreview
    {
        get
        {
            var visits = VisitsIn(NewRuleStart, NewRuleEnd);
            return $"Opens {visits} visit time{(visits == 1 ? "" : "s")} every {NewRuleWeekday}.";
        }
    }

    private string? NewExceptionProblem =>
        NewExceptionDate < ProviderToday ? "That date has already passed."
        : NewExceptionType != "block-day" && NewExceptionStart >= NewExceptionEnd ? "End time must be after the start time."
        : null;

    protected override async Task OnInitializedAsync()
    {
        IsProvider = await CurrentUser.IsProviderAsync();
        if (!IsProvider)
        {
            IsInitialized = true;
            return;
        }

        ProviderId = (await CurrentUser.GetUserIdAsync())!.Value;

        var provider = await Availability.FindProviderAsync(ProviderId);
        if (provider is not null)
        {
            SettingsLengthMinutes = SavedLengthMinutes = provider.AppointmentLengthMinutes;
            SettingsBufferMinutes = SavedBufferMinutes = provider.BufferMinutes;
            SettingsTimeZoneId = SavedTimeZoneId = provider.TimeZoneId;

            ProfileSpecialty = provider.Specialty;
            ProfileLicenseNumber = provider.LicenseNumber;
            ProfileCredentials = provider.Credentials;
            ProfileBio = provider.Bio;
            // Default to the Google avatar so most providers never have to touch this field.
            ProfilePhotoUrl = provider.PhotoUrl ?? await CurrentUser.GetPictureUrlAsync();
        }

        NewExceptionDate = ProviderToday;
        Rules = [.. await Availability.ListRulesAsync(ProviderId)];
        Exceptions = [.. await Availability.ListExceptionsAsync(ProviderId, ProviderToday)];
        IsInitialized = true;
        await RefreshSummaryAsync();
    }

    private async Task RefreshSummaryAsync()
    {
        IsLoadingSummary = true;
        try
        {
            OpenSlots = await Availability.GetOpenSlotsUtcAsync(ProviderId, ProviderToday, ProviderToday.AddDays(SummaryDays - 1));
        }
        finally
        {
            IsLoadingSummary = false;
        }
    }

    /// <summary>How many visits fit in a window, matching SlotGenerator's stepping (length + buffer).</summary>
    private int VisitsIn(TimeOnly start, TimeOnly end)
    {
        var window = (int)(end - start).TotalMinutes;
        if (end <= start || window < SavedLengthMinutes)
        {
            return 0;
        }

        return (window - SavedLengthMinutes) / (SavedLengthMinutes + SavedBufferMinutes) + 1;
    }

    private async Task SaveSettingsAsync()
    {
        IsSavingSettings = true;
        SettingsFeedback = null;
        StateHasChanged();

        try
        {
            await Availability.UpdateProviderSettingsAsync(ProviderId, SettingsLengthMinutes, SettingsBufferMinutes, SettingsTimeZoneId);
            SavedLengthMinutes = SettingsLengthMinutes;
            SavedBufferMinutes = SettingsBufferMinutes;
            SavedTimeZoneId = SettingsTimeZoneId;
            SettingsFeedback = new($"Saved. Visits are now {SavedLengthMinutes} minutes with {SavedBufferMinutes} minutes between them.");
            await RefreshSummaryAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or TimeZoneNotFoundException)
        {
            SettingsFeedback = FormFeedback.Feedback.Error(ex.Message);
        }
        finally
        {
            IsSavingSettings = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        IsSavingProfile = true;
        ProfileFeedback = null;
        StateHasChanged();

        try
        {
            await Availability.UpdateProviderProfileAsync(
                ProviderId, ProfileSpecialty, ProfileLicenseNumber, ProfileCredentials, ProfileBio, ProfilePhotoUrl);
            ProfileFeedback = new("Profile saved. Patients will see these details when they book.");
        }
        catch (ArgumentException ex)
        {
            ProfileFeedback = FormFeedback.Feedback.Error(ex.Message);
        }
        finally
        {
            IsSavingProfile = false;
        }
    }

    private async Task AddRuleAsync()
    {
        if (NewRuleProblem is not null)
        {
            return;
        }

        IsAddingRule = true;
        RulesFeedback = null;
        StateHasChanged();

        try
        {
            await Availability.AddRuleAsync(ProviderId, NewRuleWeekday, NewRuleStart, NewRuleEnd);
            RulesFeedback = new($"Added {NewRuleWeekday}, {NewRuleStart:h:mm tt} - {NewRuleEnd:h:mm tt}. {NewRulePreview}");
            Rules = [.. await Availability.ListRulesAsync(ProviderId)];
            // Step to the next day with the same times so the form doesn't instantly flag the
            // hours just added as an overlap, and filling in Mon-Fri is one click per day.
            NewRuleWeekday = Weekdays[(Array.IndexOf(Weekdays, NewRuleWeekday) + 1) % Weekdays.Length];
            await RefreshSummaryAsync();
        }
        catch (ArgumentException ex)
        {
            RulesFeedback = FormFeedback.Feedback.Error(ex.Message);
        }
        finally
        {
            IsAddingRule = false;
        }
    }

    private async Task RemoveRuleAsync(AvailabilityRule rule)
    {
        if (!RemovingRuleIds.Add(rule.Id))
        {
            return;
        }

        RulesFeedback = null;
        try
        {
            await Availability.RemoveRuleAsync(ProviderId, rule.Id);
            RulesFeedback = new($"Removed {rule.Weekday}, {rule.StartTime:h:mm tt} - {rule.EndTime:h:mm tt}. Visits already booked in those hours stay booked.");
            Rules = [.. await Availability.ListRulesAsync(ProviderId)];
            await RefreshSummaryAsync();
        }
        finally
        {
            RemovingRuleIds.Remove(rule.Id);
        }
    }

    private async Task AddExceptionAsync()
    {
        if (NewExceptionProblem is not null)
        {
            return;
        }

        IsAddingException = true;
        ExceptionsFeedback = null;
        StateHasChanged();

        var isBlocked = NewExceptionType != "open-hours";
        TimeOnly? start = NewExceptionType == "block-day" ? null : NewExceptionStart;
        TimeOnly? end = NewExceptionType == "block-day" ? null : NewExceptionEnd;

        try
        {
            await Availability.AddExceptionAsync(ProviderId, NewExceptionDate, isBlocked, start, end);
            var added = new AvailabilityException { Date = NewExceptionDate, IsBlocked = isBlocked, StartTime = start, EndTime = end };
            ExceptionsFeedback = new($"{NewExceptionDate:ddd, MMM d}: {DescribeException(added)}." +
                (isBlocked ? " Visits already booked then stay booked -- cancel them from your schedule if needed." : ""));
            Exceptions = [.. await Availability.ListExceptionsAsync(ProviderId, ProviderToday)];
            await RefreshSummaryAsync();
        }
        catch (ArgumentException ex)
        {
            ExceptionsFeedback = FormFeedback.Feedback.Error(ex.Message);
        }
        finally
        {
            IsAddingException = false;
        }
    }

    private async Task RemoveExceptionAsync(AvailabilityException ex)
    {
        if (!RemovingExceptionIds.Add(ex.Id))
        {
            return;
        }

        ExceptionsFeedback = null;
        try
        {
            await Availability.RemoveExceptionAsync(ProviderId, ex.Id);
            ExceptionsFeedback = new($"Removed the change on {ex.Date:ddd, MMM d}. That day follows your weekly hours again.");
            Exceptions = [.. await Availability.ListExceptionsAsync(ProviderId, ProviderToday)];
            await RefreshSummaryAsync();
        }
        finally
        {
            RemovingExceptionIds.Remove(ex.Id);
        }
    }

    private static string TimeZoneLabel(string id) =>
        CommonTimeZones.FirstOrDefault(tz => tz.Id == id).Label ?? id;

    private static string DescribeException(AvailabilityException ex)
    {
        if (ex.StartTime is null || ex.EndTime is null)
        {
            return "Blocked (whole day)";
        }

        var range = $"{ex.StartTime:h:mm tt} - {ex.EndTime:h:mm tt}";
        return ex.IsBlocked ? $"Blocked {range}" : $"Extra hours {range}";
    }
}
