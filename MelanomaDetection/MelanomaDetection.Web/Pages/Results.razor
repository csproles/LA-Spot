@page "/results/{ProcessingId}"
@rendermode InteractiveServer
@implements IDisposable
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager
@inject ChatPageContext ChatPageContext

<PageTitle>Analysis Results - LA Spot</PageTitle>

<div class="results-page">
    @if (AnalysisResults?.SpotId is not null)
    {
        <BackLink Href="@($"/spots/{AnalysisResults.SpotId}")" Text="Back to spot timeline" />
    }

    <PageHeader Eyebrow="SAVED CHECK" Title="Your saved check" Size="lg" />

    <MedicalDisclaimer Role="alert"
                       Message="Educational use only. This is not a substitute for professional medical diagnosis. Consult a dermatologist." />

    <ErrorAlert Message="@LoadError" />

    @if (LoadError is not null)
    {
        <div class="result-actions">
            <button type="button" class="btn btn-primary" @onclick="GoToCheck">Analyze another photo</button>
        </div>
    }
    else if (IsLoading)
    {
        <LoadingRegion Label="Loading this check">
            <AnalysisResultsSkeleton />
        </LoadingRegion>
    }
    else if (AnalysisResults is not null)
    {
        <RiskBandPanel Score="AnalysisResults.RiskScore" ShowDoctorLink="true" />

        <ChangePanel Results="AnalysisResults" />

        <AnalysisBreakdown Results="AnalysisResults" ProcessingId="@ProcessingId" />

        <div class="result-actions">
            @if (AnalysisResults.SpotId is not null)
            {
                <a href="/check?spot=@AnalysisResults.SpotId" class="btn btn-primary">Re-check this spot</a>
            }
            else
            {
                <button type="button" class="btn btn-primary" @onclick="GoToCheck">Start a new check</button>
            }
            <a href="/history" class="btn btn-outline-primary">All checks</a>
        </div>
    }
</div>

@code {
    [Parameter]
    public string ProcessingId { get; set; } = string.Empty;

    private ImageProcessingResults? AnalysisResults;
    private bool IsLoading = true;
    private string? LoadError;
    private string? LoadedForId;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(ProcessingId) || ProcessingId == LoadedForId)
        {
            return;
        }

        IsLoading = true;
        LoadError = null;
        AnalysisResults = null;

        try
        {
            AnalysisResults = await ImageProcessingService.GetResultsAsync(ProcessingId);
            LoadedForId = ProcessingId;
            SetChatContext(AnalysisResults);
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>
    /// Lets the chat widget answer "what does my score mean" from what's already on
    /// screen -- only the summary fields below, never the raw DTO. Cleared on Dispose
    /// so navigating away doesn't leave this check's data attached to later questions.
    /// </summary>
    private void SetChatContext(ImageProcessingResults results)
    {
        var band = RiskBands.Band(results.RiskScore);
        var flagged = new[] { "asymmetry", "border", "color", "diameter" }
            .Where(name => IsFlagged(results.AbcdeScores, name))
            .ToList();

        ChatPageContext.Set("results", new Dictionary<string, object?>
        {
            ["riskScore"] = results.RiskScore,
            ["riskBand"] = band,
            ["flaggedCriteria"] = flagged,
        });
    }

    private static bool IsFlagged(AbcdeScores scores, string criterion)
    {
        var details = criterion switch
        {
            "asymmetry" => scores.Asymmetry.Details,
            "border" => scores.Border.Details,
            "color" => scores.Color.Details,
            "diameter" => scores.Diameter.Details,
            _ => default,
        };

        return details.ValueKind == System.Text.Json.JsonValueKind.Object
            && details.TryGetProperty("concern", out var concern)
            && concern.ValueKind == System.Text.Json.JsonValueKind.True;
    }

    private void GoToCheck() => NavigationManager.NavigateTo("/check");

    public void Dispose() => ChatPageContext.Clear();
}
