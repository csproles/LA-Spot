@page "/map"
@using MelanomaDetection.Web.Services.RateLimiting
@rendermode InteractiveServer
@implements IDisposable
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NpiProviderService NpiService
@inject CurrentUser CurrentUser
@inject OperationRateLimiter RateLimiter
@inject ChatPageContext ChatPageContext

<PageTitle>Find a doctor - LA Spot</PageTitle>

<div class="map-page">
    <PageHeader Title="Find a doctor" Subtitle="Skin doctors (dermatologists) near you. Enter your zip code to begin." />

    @if (string.IsNullOrWhiteSpace(ApiKey))
    {
        <MapConfigNotice />
        @BookingBox
    }
    else
    {
        <ZipCodePicker IsLoading="IsLoading" ZipSubmitted="OnZipSubmitted" />

        <MapCanvas ApiKey="@ApiKey" />

        @BookingBox

        <ProviderDirectory Providers="Providers" IsLoading="IsLoading"
                           LoadError="@LoadError" RegionLabel="@CurrentRegionLabel"
                           SelectedIndex="SelectedIndex" OnProviderSelected="OnProviderSelected" />
    }
</div>

@code {
    /// <summary>Booking with our own dermatologists doesn't depend on the map, so it shows even when the map key is missing.</summary>
    private RenderFragment BookingBox => @<section class="card-panel map-book-box" aria-labelledby="map-book-title">
        <h2 id="map-book-title" class="panel-title">Book a video visit with us</h2>
        <p class="map-book-intro">
            See a dermatologist from home. Pick a provider, choose an open time and book -- no need to leave this page.
        </p>
        <VisitBooker Embedded="true" />
    </section>;

    private string? ApiKey => Configuration["GoogleMaps:ApiKey"];

    private bool IsLoading;
    private string? LoadError;
    private string? CurrentRegionLabel;
    private List<DermatologyProvider> Providers = [];
    private int? SelectedIndex;

    private async Task OnProviderSelected(int index)
    {
        if (index < 0 || index >= Providers.Count)
        {
            return;
        }

        SelectedIndex = index;
        await JS.InvokeVoidAsync("skinCheckMap.focusProvider", index);
    }

    private async Task OnZipSubmitted(string zip)
    {
        LoadError = null;
        Providers = [];
        SelectedIndex = null;
        CurrentRegionLabel = null;
        IsLoading = true;
        StateHasChanged();

        var location = await NpiService.GeocodeZipAsync(zip);
        if (location is null)
        {
            IsLoading = false;
            LoadError = $"Couldn't find zip code {zip}. Double-check it and try again.";
            await JS.InvokeVoidAsync("skinCheckMap.reset");
            return;
        }

        if (!string.Equals(location.StateAbbreviation, "LA", StringComparison.OrdinalIgnoreCase))
        {
            IsLoading = false;
            LoadError = "This tool currently only covers Louisiana zip codes.";
            await JS.InvokeVoidAsync("skinCheckMap.reset");
            return;
        }

        // Most zip codes have no dermatologist of their own, so results come
        // from the nearest metro hub -- see LouisianaRegions.NearestHub -- while
        // the map itself centres on the zip's own coordinates.
        var hub = LouisianaRegions.NearestHub(location.Lat, location.Lng);
        CurrentRegionLabel = location.PlaceName;

        // Each lookup that isn't already cached fans out to the government registries.
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is not null && RateLimiter.TryAcquire(LimitedOperation.FindProviders, userId.Value) is { } retryAfter)
        {
            IsLoading = false;
            LoadError = OperationRateLimiter.WaitMessage(retryAfter);
            await JS.InvokeVoidAsync("skinCheckMap.reset");
            return;
        }

        var found = await NpiService.GetProvidersAsync(hub.NpiCityQuery);

        IsLoading = false;
        Providers = found.ToList();
        if (Providers.Count == 0)
        {
            LoadError = $"No dermatology providers found in the NPI Registry near {location.PlaceName}, LA.";
        }
        SetChatContext();

        await JS.InvokeVoidAsync("skinCheckMap.showResults", new
        {
            center = new { lat = location.Lat, lng = location.Lng },
            zoom = hub.Zoom,
            // id is the provider's index in Providers, which is how a card click
            // finds its pin again (see skinCheckMap.focusProvider).
            providers = Providers
                .Select((provider, index) => new
                {
                    id = index,
                    name = provider.Name,
                    address = provider.Address,
                    phone = provider.Phone,
                    website = provider.Website,
                    lat = provider.Lat,
                    lng = provider.Lng,
                })
                .Where(provider => provider.lat.HasValue && provider.lng.HasValue),
        });

        StateHasChanged();
    }

    /// <summary>Lets the chat widget answer questions about the Find Care results on screen.</summary>
    private void SetChatContext()
    {
        ChatPageContext.Set("findCare", new Dictionary<string, object?>
        {
            ["region"] = CurrentRegionLabel,
            ["providersFound"] = Providers.Count,
        });
    }

    public void Dispose() => ChatPageContext.Clear();
}
