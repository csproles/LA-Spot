@page "/map"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MelanomaDetection.Web.Models
@using MelanomaDetection.Web.Services
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NpiProviderService NpiService

<PageTitle>Map - Skin Check</PageTitle>

<div class="map-page">
    <h1 class="map-title">Find Care</h1>
    <p class="map-subtitle">Dermatology providers near you.</p>

    @if (string.IsNullOrWhiteSpace(ApiKey))
    {
        <div class="card-panel map-fallback">
            <p>
                Google Maps API key isn't configured. From the
                <code>MelanomaDetection.Web</code> project folder, run:
            </p>
            <p><code>dotnet user-secrets set "GoogleMaps:ApiKey" "your-key-here"</code></p>
            <p>then restart the app.</p>
        </div>
    }
    else
    {
        <div class="parish-picker">
            <label class="parish-label" for="parishSelect">Your parish</label>
            <select id="parishSelect" class="parish-select" @bind="SelectedParish" @bind:after="OnParishChanged">
                <option value="">All Louisiana parishes</option>
                @foreach (var parish in Parishes)
                {
                    <option value="@parish">@parish</option>
                }
            </select>
        </div>
        <div id="skin-check-map" class="map-canvas"></div>
        <script type="module" src="@Assets["Pages/Map.razor.js"]"></script>

        <div class="provider-panel">
            @if (IsLoading)
            {
                <p class="provider-status">Looking up dermatology providers near @CurrentRegionLabel...</p>
            }
            else if (LoadError is not null)
            {
                <p class="provider-status">@LoadError</p>
            }
            else if (string.IsNullOrEmpty(SelectedParish))
            {
                <p class="provider-status">Select your parish to see nearby dermatology providers, pulled live from the NPI Registry.</p>
            }
            else if (Providers.Count > 0)
            {
                <p class="provider-panel-title">Dermatology providers near @CurrentRegionLabel</p>
                <ul class="provider-list">
                    @foreach (var provider in Providers)
                    {
                        <li class="provider-card">
                            <p class="provider-name">@provider.Name</p>
                            <p class="provider-address">@provider.Address</p>
                            @if (!string.IsNullOrWhiteSpace(provider.Phone))
                            {
                                <p class="provider-phone">@provider.Phone</p>
                            }
                        </li>
                    }
                </ul>
                <p class="provider-source">Source: NPI Registry (CMS). Verify insurance and availability before visiting.</p>
            }
        </div>
    }
</div>

@code {
    private string? ApiKey => Configuration["GoogleMaps:ApiKey"];

    private string SelectedParish = string.Empty;
    private bool IsLoading;
    private string? LoadError;
    private string? CurrentRegionLabel;
    private List<DermatologyProvider> Providers = [];

    private bool _mapInitialized;

    private record RegionInfo(string CityLabel, string NpiCityQuery, double Lat, double Lng, int Zoom);

    // Louisiana's 64 parishes grouped by nearest metro hub, used both to recenter the map
    // and to pick which city to query the NPI Registry for.
    private static readonly Dictionary<string, RegionInfo> Regions = new()
    {
        ["shreveport"] = new("Shreveport", "Shreveport", 32.5252, -93.7502, 9),
        ["monroe"] = new("Monroe", "Monroe", 32.5093, -92.1193, 9),
        ["alexandria"] = new("Alexandria", "Alexandria", 31.3113, -92.4451, 9),
        ["lakecharles"] = new("Lake Charles", "Lake Charles", 30.2266, -93.2174, 9),
        ["lafayette"] = new("Lafayette", "Lafayette", 30.2241, -92.0198, 9),
        ["batonrouge"] = new("Baton Rouge", "Baton Rouge", 30.4515, -91.1871, 9),
        ["hammond"] = new("Hammond", "Hammond", 30.5044, -90.4615, 9),
        ["houma"] = new("Houma", "Houma", 29.5958, -90.7195, 9),
        ["neworleans"] = new("New Orleans", "New Orleans", 29.9511, -90.0715, 9),
    };

    private static readonly Dictionary<string, string> ParishToRegion = new()
    {
        ["Acadia"] = "lafayette", ["Allen"] = "lakecharles", ["Ascension"] = "batonrouge",
        ["Assumption"] = "houma", ["Avoyelles"] = "alexandria", ["Beauregard"] = "lakecharles",
        ["Bienville"] = "shreveport", ["Bossier"] = "shreveport", ["Caddo"] = "shreveport",
        ["Calcasieu"] = "lakecharles", ["Caldwell"] = "monroe", ["Cameron"] = "lakecharles",
        ["Catahoula"] = "alexandria", ["Claiborne"] = "shreveport", ["Concordia"] = "alexandria",
        ["De Soto"] = "shreveport", ["East Baton Rouge"] = "batonrouge", ["East Carroll"] = "monroe",
        ["East Feliciana"] = "batonrouge", ["Evangeline"] = "lafayette", ["Franklin"] = "monroe",
        ["Grant"] = "alexandria", ["Iberia"] = "lafayette", ["Iberville"] = "batonrouge",
        ["Jackson"] = "monroe", ["Jefferson"] = "neworleans", ["Jefferson Davis"] = "lakecharles",
        ["Lafayette"] = "lafayette", ["Lafourche"] = "houma", ["LaSalle"] = "alexandria",
        ["Lincoln"] = "monroe", ["Livingston"] = "batonrouge", ["Madison"] = "monroe",
        ["Morehouse"] = "monroe", ["Natchitoches"] = "alexandria", ["Orleans"] = "neworleans",
        ["Ouachita"] = "monroe", ["Plaquemines"] = "neworleans", ["Pointe Coupee"] = "batonrouge",
        ["Rapides"] = "alexandria", ["Red River"] = "shreveport", ["Richland"] = "monroe",
        ["Sabine"] = "shreveport", ["St. Bernard"] = "neworleans", ["St. Charles"] = "neworleans",
        ["St. Helena"] = "batonrouge", ["St. James"] = "neworleans", ["St. John the Baptist"] = "neworleans",
        ["St. Landry"] = "lafayette", ["St. Martin"] = "lafayette", ["St. Mary"] = "houma",
        ["St. Tammany"] = "hammond", ["Tangipahoa"] = "hammond", ["Tensas"] = "monroe",
        ["Terrebonne"] = "houma", ["Union"] = "monroe", ["Vermilion"] = "lafayette",
        ["Vernon"] = "alexandria", ["Washington"] = "hammond", ["Webster"] = "shreveport",
        ["West Baton Rouge"] = "batonrouge", ["West Carroll"] = "monroe", ["West Feliciana"] = "batonrouge",
        ["Winn"] = "alexandria",
    };

    private static readonly string[] Parishes = [.. ParishToRegion.Keys.Order()];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(ApiKey) && !_mapInitialized)
        {
            _mapInitialized = true;
            await JS.InvokeVoidAsync("skinCheckMap.init", "skin-check-map", ApiKey);
        }
    }

    private async Task OnParishChanged()
    {
        LoadError = null;
        Providers = [];

        if (string.IsNullOrEmpty(SelectedParish) ||
            !ParishToRegion.TryGetValue(SelectedParish, out var regionKey) ||
            !Regions.TryGetValue(regionKey, out var region))
        {
            CurrentRegionLabel = null;
            await JS.InvokeVoidAsync("skinCheckMap.reset");
            return;
        }

        CurrentRegionLabel = region.CityLabel;
        IsLoading = true;
        StateHasChanged();

        var providers = await NpiService.GetProvidersAsync(region.NpiCityQuery);

        IsLoading = false;
        Providers = providers.ToList();
        if (Providers.Count == 0)
        {
            LoadError = $"No dermatology providers found in the NPI Registry for {region.CityLabel}, LA.";
        }

        await JS.InvokeVoidAsync("skinCheckMap.showResults", new
        {
            center = new { lat = region.Lat, lng = region.Lng },
            zoom = region.Zoom,
            providers = Providers
                .Where(p => p.Lat.HasValue && p.Lng.HasValue)
                .Select(p => new { name = p.Name, lat = p.Lat, lng = p.Lng }),
        });

        StateHasChanged();
    }
}
