@page "/map"
@rendermode InteractiveServer
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NpiProviderService NpiService

<PageTitle>Map - Skin Check</PageTitle>

<div class="map-page">
    <PageHeader Title="Find Care" Subtitle="Dermatology providers near you." />

    @if (string.IsNullOrWhiteSpace(ApiKey))
    {
        <MapConfigNotice />
    }
    else
    {
        <ParishPicker Parishes="LouisianaRegions.Parishes" Parish="@SelectedParish"
                      ParishChanged="OnParishChanged" />

        <MapCanvas ApiKey="@ApiKey" />

        <ProviderDirectory Providers="Providers" IsLoading="IsLoading"
                           LoadError="@LoadError" RegionLabel="@CurrentRegionLabel" />
    }
</div>

@code {
    private string? ApiKey => Configuration["GoogleMaps:ApiKey"];

    private string SelectedParish = string.Empty;
    private bool IsLoading;
    private string? LoadError;
    private string? CurrentRegionLabel;
    private List<DermatologyProvider> Providers = [];

    private async Task OnParishChanged(string parish)
    {
        SelectedParish = parish;
        LoadError = null;
        Providers = [];

        var region = LouisianaRegions.ForParish(string.IsNullOrEmpty(parish) ? null : parish);
        if (region is null)
        {
            CurrentRegionLabel = null;
            await JS.InvokeVoidAsync("skinCheckMap.reset");
            return;
        }

        CurrentRegionLabel = region.CityLabel;
        IsLoading = true;
        StateHasChanged();

        var found = await NpiService.GetProvidersAsync(region.NpiCityQuery);

        IsLoading = false;
        Providers = found.ToList();
        if (Providers.Count == 0)
        {
            LoadError = $"No dermatology providers found in the NPI Registry for {region.CityLabel}, LA.";
        }

        await JS.InvokeVoidAsync("skinCheckMap.showResults", new
        {
            center = new { lat = region.Lat, lng = region.Lng },
            zoom = region.Zoom,
            providers = Providers
                .Where(provider => provider.Lat.HasValue && provider.Lng.HasValue)
                .Select(provider => new { name = provider.Name, lat = provider.Lat, lng = provider.Lng }),
        });

        StateHasChanged();
    }
}
