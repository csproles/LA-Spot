@page "/provider"
@rendermode InteractiveServer
@inject BookingService Booking
@inject CurrentUser CurrentUser
@inject IJSRuntime JS

<PageTitle>Schedule - LA Spot</PageTitle>

@if (!IsInitialized)
{
    <SkeletonBlock Height="200px" Shape="card" />
}
else if (!IsProvider)
{
    <EmptyState Title="Provider accounts only" Description="This page is for dermatologist accounts." ActionHref="/" ActionText="Go home" />
}
else
{
    <div class="provider-page">
        <PageHeader Title="Your schedule" Subtitle="@ProviderName">
            <Actions>
                <a href="/provider/settings" class="btn btn-outline-primary">Hours &amp; profile</a>
            </Actions>
        </PageHeader>

        @if (Upcoming.Count == 0)
        {
            <EmptyState Title="No visits scheduled" Description="Booked visits will show up here." ActionHref="/provider/settings" ActionText="Set your hours" />
        }
        else
        {
            @foreach (var day in UpcomingByDay)
            {
                <section class="card-panel schedule-day">
                    <h2 class="panel-title">@day.Key</h2>
                    @foreach (var appt in day)
                    {
                        <ScheduleVisitRow Appointment="appt" BrowserTimeZoneId="@BrowserTimeZoneId" />
                    }
                </section>
            }
        }
    </div>
}

@code {
    private bool IsInitialized;
    private bool IsProvider;
    private string ProviderName = "";
    private string? BrowserTimeZoneId;
    private List<AppointmentView> Upcoming = [];

    private IEnumerable<IGrouping<string, AppointmentView>> UpcomingByDay =>
        Upcoming.GroupBy(a => ClientTimeZone.Format(a.StartUtc, BrowserTimeZoneId, "dddd, MMM d"));

    protected override async Task OnInitializedAsync()
    {
        IsProvider = await CurrentUser.IsProviderAsync();
        if (IsProvider)
        {
            var providerId = (await CurrentUser.GetUserIdAsync())!.Value;
            ProviderName = await CurrentUser.GetDisplayNameAsync() ?? "";
            Upcoming = [.. (await Booking.ListForProviderAsync(providerId))
                .Where(a => a.Status == AppointmentStatus.Booked && a.EndUtc >= DateTime.UtcNow)
                .OrderBy(a => a.StartUtc)];
        }

        IsInitialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            BrowserTimeZoneId = await JS.InvokeAsync<string>("skinCheckScheduling.getTimeZone");
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }
}
