@page "/onboarding"
@rendermode InteractiveServer
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager

<PageTitle>Your risk profile - LA Spot</PageTitle>

<div class="onboarding-page">
    <PageHeader Eyebrow="RISK PROFILE"
                Title="A few questions about your skin"
                Subtitle="These are the personal risk factors dermatologists screen on. They tune how often we suggest rechecking each spot, and you can change them any time in Profile." />

    <RiskProfileForm @bind-Profile="Profile" IsLoading="IsLoading" />

    <div class="onboarding-actions">
        <button type="button" class="btn btn-primary" disabled="@(IsSaving || IsLoading)" @onclick="Save">
            @if (IsSaving)
            {
                <span class="btn-spinner" aria-hidden="true"></span>
            }
            Save and continue
        </button>
        <a href="/" class="link-button">Skip for now</a>
    </div>
    <FormFeedback Value="SaveFeedback" />
</div>

@code {
    private RiskProfile Profile = new();
    private bool IsLoading = true;
    private bool IsSaving;
    private FormFeedback.Feedback? SaveFeedback;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await ImageProcessingService.GetProfileAsync();
            if (existing.Configured)
            {
                Profile = existing;
            }
        }
        catch (ImageProcessingApiException)
        {
            // A fresh form is fine if the profile couldn't be loaded; saving will surface any real error.
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Save()
    {
        IsSaving = true;
        SaveFeedback = null;
        try
        {
            await ImageProcessingService.SaveProfileAsync(Profile);
            NavigationManager.NavigateTo("/?saved=profile");
        }
        catch (ImageProcessingApiException ex)
        {
            SaveFeedback = FormFeedback.Feedback.Error($"Your answers weren't saved: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }
}
