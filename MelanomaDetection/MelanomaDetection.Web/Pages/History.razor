@page "/history"
@rendermode InteractiveServer
@implements IDisposable
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager
@inject ChatPageContext ChatPageContext

<PageTitle>All checks - LA Spot</PageTitle>

<div class="history-page">
    <PageHeader Title="All checks">
        <Details>
            @if (IsLoading)
            {
                <SkeletonBlock Width="260px" Height="13px" />
            }
            else
            {
                <span>
                    @(Entries.Count == Total
                        ? $"{Entries.Count} saved check{(Entries.Count == 1 ? "" : "s")}"
                        : $"{Entries.Count} of {Total} saved checks") across every spot ·
                    <a href="/spots">view by spot</a>
                </span>
            }
        </Details>
        <Actions>
            @if (Entries.Count > 0)
            {
                <button type="button" class="btn @(IsCompareMode ? "btn-primary" : "btn-outline-primary")"
                        @onclick="ToggleCompareMode">
                    @(IsCompareMode ? "Done comparing" : "Compare")
                </button>
            }
        </Actions>
    </PageHeader>

    <ErrorAlert Message="@LoadError" />

    @if (LoadError is null)
    {
        @if (!IsLoading && Entries.Count == 0)
        {
            <EmptyState Description="No saved checks yet. Analyze a photo and save it to see it here."
                        ActionHref="/check"
                        ActionText="New skin check" />
        }
        else
        {
            <HistorySortBar @bind-SortField="SortField" @bind-Descending="SortDescending" />

            @if (IsCompareMode)
            {
                <p class="compare-hint">Select up to 2 checks to compare. Selecting a 3rd drops the oldest selection.</p>
            }

            <HistoryGrid Entries="SortedEntries" IsLoading="IsLoading"
                         SelectedIds="SelectedForCompare" OnCardClick="HandleCardClick" />

            @if (!IsLoading && Entries.Count < Total)
            {
                <div class="history-load-more">
                    <button type="button" class="btn btn-outline-primary" disabled="@IsLoadingMore" @onclick="LoadMoreAsync">
                        @(IsLoadingMore ? "Loading…" : $"Load {Math.Min(PageSize, Total - Entries.Count)} more")
                    </button>
                </div>
            }

            @if (IsCompareMode && ComparedEntries.Count > 0)
            {
                <HistoryComparePanel Entries="ComparedEntries" />
            }
        }
    }
</div>

@code {
    /// <summary>How many checks a "Load more" click fetches at a time. Keeps the
    /// initial page (and every subsequent one) from rendering an unbounded DOM
    /// as someone's history grows -- see store.list_checks/count_checks.</summary>
    private const int PageSize = 40;

    private List<HistoryEntry> Entries = new();
    private int Total;
    private bool IsLoading = true;
    private bool IsLoadingMore;
    private string? LoadError;
    private string SortField = "Date";
    private bool SortDescending = true;
    private bool IsCompareMode;
    private readonly List<string> SelectedForCompare = new();

    private List<HistoryEntry> SortedEntries
    {
        get
        {
            IEnumerable<HistoryEntry> sorted = SortField == "Location"
                ? Entries.OrderBy(entry => entry.Location, StringComparer.OrdinalIgnoreCase)
                : Entries.OrderBy(entry => entry.ProcessedAt);
            return (SortDescending ? sorted.Reverse() : sorted).ToList();
        }
    }

    private List<HistoryEntry> ComparedEntries =>
        Entries.Where(entry => SelectedForCompare.Contains(entry.ProcessingId)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var page = await ImageProcessingService.GetHistoryPageAsync(PageSize, 0);
            Entries = page.Entries;
            Total = page.Total;
            SetChatContext();
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        IsLoadingMore = true;
        try
        {
            var page = await ImageProcessingService.GetHistoryPageAsync(PageSize, Entries.Count);
            Entries.AddRange(page.Entries);
            Total = page.Total;
            SetChatContext();
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoadingMore = false;
        }
    }

    /// <summary>Lets the chat widget answer questions about the person's overall check history.
    /// earliest/latestCheck reflect only what's loaded so far, not the full history, once
    /// "Load more" pagination means Entries isn't the complete list.</summary>
    private void SetChatContext()
    {
        ChatPageContext.Set("history", new Dictionary<string, object?>
        {
            ["totalChecks"] = Total,
            ["loadedChecks"] = Entries.Count,
            ["latestCheck"] = Entries.Select(e => e.ProcessedAt).Max()?.ToString("yyyy-MM-dd"),
        });
    }

    private void ToggleCompareMode()
    {
        IsCompareMode = !IsCompareMode;
        if (!IsCompareMode)
        {
            SelectedForCompare.Clear();
        }
    }

    private void HandleCardClick(HistoryEntry entry)
    {
        if (!IsCompareMode)
        {
            NavigationManager.NavigateTo($"/results/{entry.ProcessingId}");
            return;
        }

        if (!SelectedForCompare.Remove(entry.ProcessingId))
        {
            if (SelectedForCompare.Count >= 2)
            {
                SelectedForCompare.RemoveAt(0);
            }
            SelectedForCompare.Add(entry.ProcessingId);
        }
    }

    public void Dispose() => ChatPageContext.Clear();
}
