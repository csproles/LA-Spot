@page "/spots/{SpotId}"
@rendermode InteractiveServer
@implements IDisposable
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager
@inject ChatPageContext ChatPageContext

<PageTitle>@(Spot?.Label ?? "Spot") - LA Spot</PageTitle>

<div class="spot-page">
    <BackLink Href="/spots" Text="All spots" />

    <ErrorAlert Message="@LoadError" />

    @if (LoadError is null && Spot is null)
    {
        <LoadingRegion Label="Loading this spot">
            <SpotDetailSkeleton />
        </LoadingRegion>
    }
    else if (Spot is not null)
    {
        <SpotDetailHeader Spot="Spot" OnRename="SaveRename" IsSaving="IsSaving" />

        <FormFeedback Value="SaveFeedback" />

        @if (Spot.Checks.Count == 0)
        {
            <EmptyState Title="No photos yet"
                        Description="Take the first photo of this spot to start its timeline."
                        ActionHref="@($"/check?spot={Spot.Id}")"
                        ActionText="Photograph this spot" />
        }
        else
        {
            <div class="spot-grid">
                <SpotRiskTrendPanel Spot="Spot" />
                <SpotLatestChangePanel Checks="Spot.Checks" />
            </div>

            <SpotTimeline Checks="Spot.Checks" OnOpenCheck="OpenCheck" />
        }

        <div class="spot-archive">
            @if (Spot.Checks.Count > 0)
            {
                <button type="button" class="link-button spot-archive-button" @onclick="ArchiveSpot" disabled="@IsSaving">
                    @(ConfirmArchive ? "Tap again to confirm: this hides the spot and its history" : "Archive this spot")
                </button>
            }
            @if (!ConfirmDelete)
            {
                <button type="button" class="link-button spot-delete-button" @onclick="() => ConfirmDelete = true" disabled="@IsSaving">
                    Delete this spot
                </button>
            }
        </div>

        @if (ConfirmDelete)
        {
            <div class="spot-delete-confirm" role="alertdialog" aria-labelledby="spot-delete-title" aria-describedby="spot-delete-text">
                <p id="spot-delete-title" class="spot-delete-title">Delete &ldquo;@Spot.Label&rdquo;?</p>
                <p id="spot-delete-text" class="spot-delete-text">
                    @(Spot.Checks.Count == 0
                        ? "This permanently removes the spot. It has no photos yet. It can't be undone."
                        : $"This permanently removes the spot and its {Spot.Checks.Count} saved check{(Spot.Checks.Count == 1 ? "" : "s")}, including the photos and breakdown images. It can't be undone. To keep the history but hide the spot, archive it instead.")
                </p>
                <div class="spot-delete-actions">
                    <button type="button" class="btn spot-delete-confirm-button" @onclick="DeleteSpot" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                        }
                        @(IsSaving ? "Deleting…" : "Delete spot")
                    </button>
                    <button type="button" class="btn btn-outline-primary" @onclick="() => ConfirmDelete = false" disabled="@IsSaving">Cancel</button>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string SpotId { get; set; } = string.Empty;

    private SpotDetail? Spot;
    private string? LoadError;
    private FormFeedback.Feedback? SaveFeedback;
    private bool IsSaving;
    private bool ConfirmArchive;
    private bool ConfirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        if (Spot?.Id == SpotId)
        {
            return;
        }

        Spot = null;
        LoadError = null;
        try
        {
            Spot = await ImageProcessingService.GetSpotAsync(SpotId);
            SetChatContext(Spot);
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
    }

    /// <summary>Lets the chat widget answer questions about this spot's tracked history.</summary>
    private void SetChatContext(SpotDetail spot)
    {
        ChatPageContext.Set("spot", new Dictionary<string, object?>
        {
            ["spotLabel"] = spot.Label,
            ["bodyRegion"] = spot.BodyRegion,
            ["checkCount"] = spot.CheckCount,
            ["lastRiskScore"] = spot.LastRiskScore,
            ["trend"] = spot.Trend,
        });
    }

    // Called through a plain Func, not an EventCallback, so this page doesn't re-render on
    // its own afterwards -- without the StateHasChanged calls the spinner and message never show.
    private async Task<bool> SaveRename(string label)
    {
        IsSaving = true;
        SaveFeedback = null;
        StateHasChanged();
        try
        {
            var updated = await ImageProcessingService.UpdateSpotAsync(SpotId, label: label);
            Spot!.Label = updated.Label;
            SaveFeedback = new($"Renamed to \u201c{updated.Label}\u201d.");
            return true;
        }
        catch (ImageProcessingApiException ex)
        {
            SaveFeedback = FormFeedback.Feedback.Error($"The new name wasn't saved: {ex.Message}");
            return false;
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private async Task ArchiveSpot()
    {
        if (!ConfirmArchive)
        {
            ConfirmArchive = true;
            return;
        }

        IsSaving = true;
        SaveFeedback = null;
        try
        {
            await ImageProcessingService.UpdateSpotAsync(SpotId, archived: true);
            NavigationManager.NavigateTo($"/spots?archived={Uri.EscapeDataString(Spot!.Label)}");
        }
        catch (ImageProcessingApiException ex)
        {
            SaveFeedback = FormFeedback.Feedback.Error($"The spot wasn't archived: {ex.Message}");
            ConfirmArchive = false;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeleteSpot()
    {
        IsSaving = true;
        SaveFeedback = null;
        try
        {
            await ImageProcessingService.DeleteSpotAsync(SpotId);
            NavigationManager.NavigateTo($"/spots?deleted={Uri.EscapeDataString(Spot!.Label)}");
        }
        catch (ImageProcessingApiException ex)
        {
            SaveFeedback = FormFeedback.Feedback.Error($"The spot wasn't deleted: {ex.Message}");
            ConfirmDelete = false;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenCheck(LASpot check) =>
        NavigationManager.NavigateTo($"/results/{check.ProcessingId}");

    public void Dispose() => ChatPageContext.Clear();
}
