@page "/spots/{SpotId}"
@rendermode InteractiveServer
@inject ImageProcessingService ImageProcessingService
@inject NavigationManager NavigationManager

<PageTitle>@(Spot?.Label ?? "Spot") - LA Spot</PageTitle>

<div class="spot-page">
    <BackLink Href="/spots" Text="All spots" />

    <ErrorAlert Message="@LoadError" />

    @if (LoadError is null && Spot is null)
    {
        <LoadingRegion Label="Loading this spot">
            <SpotDetailSkeleton />
        </LoadingRegion>
    }
    else if (Spot is not null)
    {
        <SpotDetailHeader Spot="Spot" OnRename="SaveRename" IsSaving="IsSaving" />

        <ErrorAlert Message="@SaveError" />

        @if (Spot.Checks.Count == 0)
        {
            <EmptyState Title="No photos yet"
                        Description="Take the first photo of this spot to start its timeline."
                        ActionHref="@($"/check?spot={Spot.Id}")"
                        ActionText="Photograph this spot" />
        }
        else
        {
            <div class="spot-grid">
                <SpotRiskTrendPanel Spot="Spot" />
                <SpotLatestChangePanel Checks="Spot.Checks" />
            </div>

            <SpotTimeline Checks="Spot.Checks" OnOpenCheck="OpenCheck" />

            <div class="spot-archive">
                <button type="button" class="link-button spot-archive-button" @onclick="ArchiveSpot" disabled="@IsSaving">
                    @(ConfirmArchive ? "Tap again to confirm — this hides the spot and its history" : "Archive this spot")
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string SpotId { get; set; } = string.Empty;

    private SpotDetail? Spot;
    private string? LoadError;
    private string? SaveError;
    private bool IsSaving;
    private bool ConfirmArchive;

    protected override async Task OnParametersSetAsync()
    {
        if (Spot?.Id == SpotId)
        {
            return;
        }

        Spot = null;
        LoadError = null;
        try
        {
            Spot = await ImageProcessingService.GetSpotAsync(SpotId);
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
    }

    private async Task<bool> SaveRename(string label)
    {
        IsSaving = true;
        SaveError = null;
        try
        {
            var updated = await ImageProcessingService.UpdateSpotAsync(SpotId, label: label);
            Spot!.Label = updated.Label;
            return true;
        }
        catch (ImageProcessingApiException ex)
        {
            SaveError = ex.Message;
            return false;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ArchiveSpot()
    {
        if (!ConfirmArchive)
        {
            ConfirmArchive = true;
            return;
        }

        IsSaving = true;
        SaveError = null;
        try
        {
            await ImageProcessingService.UpdateSpotAsync(SpotId, archived: true);
            NavigationManager.NavigateTo("/spots");
        }
        catch (ImageProcessingApiException ex)
        {
            SaveError = ex.Message;
            ConfirmArchive = false;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenCheck(LASpot check) =>
        NavigationManager.NavigateTo($"/results/{check.ProcessingId}");
}
