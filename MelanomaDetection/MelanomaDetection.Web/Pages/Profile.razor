@page "/profile"
@rendermode InteractiveServer
@inject ImageProcessingService ImageProcessingService

<PageTitle>Profile - Skin Check</PageTitle>

<div class="profile-page">
    <PageHeader Title="Profile">
        <Actions>
            <button type="button" class="btn btn-primary" disabled="@(IsSaving || !IsDirty)" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="btn-spinner" aria-hidden="true"></span>
                }
                @(IsSaving ? "Saving…" : IsDirty ? "Save changes" : "Saved")
            </button>
        </Actions>
    </PageHeader>

    <ErrorAlert Message="@LoadError" />
    <ErrorAlert Message="@SaveError" />

    <AccountPanel IsLoading="IsLoading" FullName="@Model.FullName" FullNameChanged="UpdateFullName" />

    <section class="profile-section">
        <div class="section-heading">
            <h2 class="section-title">Risk profile</h2>
            <p class="text-muted-small">
                Tunes how often each spot is due for a recheck.
                @(IsLoading || Model.Configured ? "" : "Not set up yet.")
            </p>
        </div>
        <RiskProfileForm Profile="Model" IsLoading="IsLoading" ProfileChanged="_ => IsDirty = true" />
    </section>

    <NotificationSettingsPanel />

    <PrivacySettingsPanel />

    <AppPreferencesPanel />

    <DataAccountPanel />
</div>

@code {
    private RiskProfile Model = new();
    private bool IsLoading = true;
    private bool IsDirty;
    private bool IsSaving;
    private string? LoadError;
    private string? SaveError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model = await ImageProcessingService.GetProfileAsync();
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void UpdateFullName(string fullName)
    {
        Model.FullName = fullName;
        IsDirty = true;
    }

    private async Task Save()
    {
        IsSaving = true;
        SaveError = null;
        try
        {
            Model = await ImageProcessingService.SaveProfileAsync(Model);
            IsDirty = false;
        }
        catch (ImageProcessingApiException ex)
        {
            SaveError = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}
