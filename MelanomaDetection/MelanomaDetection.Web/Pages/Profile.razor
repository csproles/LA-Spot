@page "/profile"
@rendermode InteractiveServer
@implements IDisposable
@inject ImageProcessingService ImageProcessingService
@inject ChatPageContext ChatPageContext

<PageTitle>Profile - LA Spot</PageTitle>

<div class="profile-page">
    <PageHeader Title="Profile">
        <Actions>
            <button type="button" class="btn btn-primary" disabled="@(IsSaving || !IsDirty)" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="btn-spinner" aria-hidden="true"></span>
                }
                @(IsSaving ? "Saving…" : IsDirty ? "Save changes" : "Saved")
            </button>
        </Actions>
    </PageHeader>

    <ErrorAlert Message="@LoadError" />
    <ErrorAlert Message="@SaveError" />

    <SessionPanel />

    <AccountPanel IsLoading="IsLoading" FullName="@Model.FullName" FullNameChanged="UpdateFullName" />

    <section class="profile-section">
        <div class="section-heading">
            <h2 class="section-title">Risk profile</h2>
            <p class="text-muted-small">
                Tunes how often each spot is due for a recheck.
                @(IsLoading || Model.Configured ? "" : "Not set up yet.")
            </p>
        </div>
        <RiskProfileForm Profile="Model" IsLoading="IsLoading" ProfileChanged="_ => IsDirty = true" />
    </section>

    <NotificationSettingsPanel Profile="Model" ProfileChanged="_ => IsDirty = true" />

    <PrivacySettingsPanel Profile="Model" ProfileChanged="_ => IsDirty = true" />

    <AppPreferencesPanel />

    <DataAccountPanel ReportFailed="@(Report == "failed")" />
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Report { get; set; }

    private RiskProfile Model = new();
    private bool IsLoading = true;
    private bool IsDirty;
    private bool IsSaving;
    private string? LoadError;
    private string? SaveError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model = await ImageProcessingService.GetProfileAsync();
            SetChatContext();
        }
        catch (ImageProcessingApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>
    /// Lets the chat widget answer questions about the risk profile the person is looking
    /// at -- only the risk-relevant fields, never the name or free-text location.
    /// </summary>
    private void SetChatContext()
    {
        ChatPageContext.Set("profile", new Dictionary<string, object?>
        {
            ["configured"] = Model.Configured,
            ["sunExposure"] = Model.SunExposure,
            ["fitzpatrick"] = Model.Fitzpatrick,
            ["familyHistory"] = Model.FamilyHistory,
            ["blisteringSunburns"] = Model.BlisteringSunburns,
            ["manyMoles"] = Model.ManyMoles,
            ["hasElevatedRiskFactors"] = Model.HasElevatedRiskFactors,
        });
    }

    private void UpdateFullName(string fullName)
    {
        Model.FullName = fullName;
        IsDirty = true;
    }

    private async Task Save()
    {
        IsSaving = true;
        SaveError = null;
        try
        {
            Model = await ImageProcessingService.SaveProfileAsync(Model);
            IsDirty = false;
            SetChatContext();
        }
        catch (ImageProcessingApiException ex)
        {
            SaveError = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    public void Dispose() => ChatPageContext.Clear();
}
