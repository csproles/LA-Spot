@page "/book-visit"
@rendermode InteractiveServer
@inject ImageProcessingService ImageProcessingService

<PageTitle>Book a visit - LA Spot</PageTitle>

<div class="book-visit-page">
    <PageHeader Title="Consult a Dermatologist" Subtitle="Talk to a dermatologist from home. Pick a provider, then an open time." />

    <MedicalDisclaimer Role="note"
        Message="This app does not provide a diagnosis. Consultations are for informational purposes. This demo is not HIPAA-compliant." />

    <VisitBooker ScanQuery="@ScanQuery" ScanResult="ScanResult" ScanLoadError="@ScanLoadError" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "scan")]
    public string? ScanQuery { get; set; }

    private ImageProcessingResults? ScanResult;
    private string? ScanLoadError;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(ScanQuery))
        {
            return;
        }

        try
        {
            ScanResult = await ImageProcessingService.GetResultsAsync(ScanQuery);
        }
        catch (ImageProcessingApiException)
        {
            ScanLoadError = "Couldn't load that scan result. You can still book without it.";
        }
    }
}
