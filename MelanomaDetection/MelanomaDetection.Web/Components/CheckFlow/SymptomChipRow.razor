@* Multi-select chips for what the user has noticed about the spot. Saved with
   the check, so a clinician sees them alongside the numbers. *@

<div class="chip-row" role="group" aria-label="Symptoms">
    @foreach (var symptom in Symptoms)
    {
        var isSelected = Selected.Contains(symptom);
        <button type="button"
                class="chip @(isSelected ? "chip-selected" : "")"
                aria-pressed="@(isSelected ? "true" : "false")"
                @onclick="() => Toggle(symptom)">
            @symptom
        </button>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<string> Symptoms { get; set; } = new[]
    {
        "Itchy", "Growing", "Bleeding", "Painful", "Changed color", "New",
    };

    [Parameter, EditorRequired]
    public HashSet<string> Selected { get; set; } = new();

    [Parameter]
    public EventCallback<HashSet<string>> SelectedChanged { get; set; }

    private async Task Toggle(string symptom)
    {
        if (!Selected.Remove(symptom))
        {
            Selected.Add(symptom);
        }

        await SelectedChanged.InvokeAsync(Selected);
    }
}
