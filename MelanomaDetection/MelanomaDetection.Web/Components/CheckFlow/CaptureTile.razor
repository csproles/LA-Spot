@* A big tap target: icon, what it does, and what to expect. Either a plain
   button, or a tile with a transparent <InputFile> laid over it so tapping
   anywhere opens the camera or picker. *@

@if (OnClick.HasDelegate)
{
    <button type="button" class="capture-tile capture-tile-@Variant" @onclick="OnClick">
        @TileBody
    </button>
}
else
{
    <div class="capture-tile capture-tile-@Variant">
        @TileBody
        @ChildContent
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string IconName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>"default" or "primary" for the filled navy treatment.</summary>
    [Parameter]
    public string Variant { get; set; } = "default";

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>The file input that overlays the tile, when there is one.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment TileBody => @<text>
        <span class="capture-icon">
            <AppIcon Name="@IconName" Size="xl" />
        </span>
        <span class="capture-text">
            <span class="capture-title">@Title</span>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="capture-subtitle">@Subtitle</span>
            }
        </span>
    </text>;
}
