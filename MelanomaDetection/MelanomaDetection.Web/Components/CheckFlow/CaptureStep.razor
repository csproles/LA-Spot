@* Step 2: take or choose the photo. *@

<div class="capture-step">
    <CaptureGuidancePanel IsRecheck="IsRecheck" />

    @if (!string.IsNullOrEmpty(RetakeHint))
    {
        <div class="retake-hint" role="status">
            <span class="retake-hint-icon">
                <AppIcon Name="retry" Size="md" />
            </span>
            <span>@RetakeHint</span>
        </div>
    }

    <div class="capture-actions">
        <CameraCapture OnFileSelected="OnFileSelected" OnCaptured="OnPhotoCaptured" />

        <CaptureTile IconName="gallery" Title="Choose from gallery" Subtitle="JPEG, PNG or WebP. Large photos are shrunk to fit">
            <InputFile OnChange="OnFileSelected" accept="image/*"
                       class="capture-input" aria-label="Choose a photo from your gallery" />
        </CaptureTile>
    </div>

    <div class="result-actions">
        <button type="button" class="btn btn-outline-primary" @onclick="OnChangeSpot"><AppIcon Name="chevron-left" Size="md" /> Change spot</button>
    </div>
</div>

@code {
    [Parameter]
    public bool IsRecheck { get; set; }

    /// <summary>Why the previous photo was thrown away, when one was.</summary>
    [Parameter]
    public string? RetakeHint { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }

    /// <summary>A JPEG frame captured from the in-app camera viewfinder.</summary>
    [Parameter, EditorRequired]
    public EventCallback<byte[]> OnPhotoCaptured { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnChangeSpot { get; set; }
}
