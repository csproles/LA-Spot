@* Step 6: the verdict, what changed since last time, and the chance to file
   this check under the spot. *@

<div class="results-step">
    <RiskModelPanel Result="RiskModelResult" />

    <RiskBandPanel Score="Results.RiskScore" OverallVisualConcern="@Results.OverallVisualConcern" ShowDoctorLink="IsSaved" ProcessingId="@ProcessingId" />

    <MultiLesionNotice Results="Results" />

    <ChangePanel Results="Results" />

    <AbcdFactorPanel Scores="Results.AbcdeScores" />

    <div class="result-actions">
        <button type="button" class="btn btn-primary" disabled="@(IsSaving || IsSaved)" @onclick="OnSave">
            @if (IsSaving)
            {
                <span class="btn-spinner" aria-hidden="true"></span>
            }
            @if (IsSaved)
            {
                <AppIcon Name="check" Size="md" StrokeWidth="2.4" />
            }
            @(IsSaved ? "Saved" : IsSaving ? "Saving…" : "Save this check")
        </button>
        @if (IsSaved && Results.SpotId is not null)
        {
            <a href="/spots/@Results.SpotId" class="btn btn-outline-primary">See this spot's history</a>
        }
        <button type="button" class="btn btn-outline-primary" @onclick="OnStartAnother">Check another spot</button>
    </div>

    <BreakdownDisclosure Results="Results" ProcessingId="@ProcessingId" />
</div>

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;

    [Parameter, EditorRequired]
    public string ProcessingId { get; set; } = string.Empty;

    /// <summary>Null when POST /predict wasn't called or failed -- RiskModelPanel renders nothing then.</summary>
    [Parameter]
    public PredictResponse? RiskModelResult { get; set; }

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public bool IsSaved { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnSave { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnStartAnother { get; set; }
}
