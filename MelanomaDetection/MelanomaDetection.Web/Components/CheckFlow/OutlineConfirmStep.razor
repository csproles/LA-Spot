@* Step 4: every downstream score is computed from this outline, so a bad
   segmentation is worth catching here rather than reporting a confident
   number about the wrong pixels. On NoDetection there is no outline to
   confirm at all -- asking "does this match" over a blank photo is
   confusing, so this step explains the failure and only offers a retake. *@

<div class="card-panel outline-step">
    @if (NoDetection)
    {
        <h2 class="panel-title">No spot could be located in this photo</h2>
        <p class="text-muted-small">
            The automated detection could not confidently locate a spot to outline, so no
            visual-concern analysis was produced for this photo. This does not mean the spot is fine
            -- it means this photo didn't give the tool enough to go on. Try retaking it with the spot
            centered, in focus, and well lit.
        </p>
        <div class="result-actions">
            <button type="button" class="btn btn-primary" @onclick="OnReject">Retake the photo</button>
        </div>
    }
    else
    {
        <h2 class="panel-title">Does the outline match your spot?</h2>
        <p class="text-muted-small">
            Every score depends on this outline, so it's worth a second. The traced line should hug the
            edge of the spot — not cut into it, and not wander off into surrounding skin, hair, or the
            edge of the photo.
        </p>
        @if (ImageData.HasImage(BorderVisual))
        {
            <img src="@ImageData.PngUrl(BorderVisual!)" alt="Detected lesion border overlay" class="segmentation-preview" />
        }
        <div class="result-actions">
            <button type="button" class="btn btn-primary" @onclick="OnAccept">Yes, that matches</button>
            <button type="button" class="btn btn-outline-primary" @onclick="OnReject">No — retake the photo</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? BorderVisual { get; set; }

    /// <summary>True when no lesion was detected at all -- see
    /// ImageProcessingResults.NoDetection. Skips the "does this match"
    /// question entirely, since there is no outline to confirm.</summary>
    [Parameter]
    public bool NoDetection { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnAccept { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnReject { get; set; }
}
