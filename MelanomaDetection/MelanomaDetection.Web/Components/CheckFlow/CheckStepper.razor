@* Progress through a check. Confirming the photo and confirming the outline
   both sit under "Photo": the user is still working on getting a usable photo
   until the outline is accepted, and showing them slip backwards would read
   as an error. *@

<ol class="stepper" aria-label="Progress">
    @foreach (var (step, label, number) in Steps)
    {
        <li class="stepper-step @StateClass(step)">
            <span class="stepper-dot">
                @if (step < DisplayStep)
                {
                    <AppIcon Name="check" Size="sm" StrokeWidth="2.6" />
                }
                else
                {
                    @number
                }
            </span>
            <span class="stepper-label">@label</span>
        </li>
    }
</ol>

@code {
    private static readonly (CheckStep Step, string Label, int Number)[] Steps =
    {
        (CheckStep.Spot, "Spot", 1),
        (CheckStep.Capture, "Photo", 2),
        (CheckStep.Details, "Details", 3),
        (CheckStep.Results, "Results", 4),
    };

    [Parameter, EditorRequired]
    public CheckStep CurrentStep { get; set; }

    private CheckStep DisplayStep =>
        CurrentStep is CheckStep.Confirm or CheckStep.Outline ? CheckStep.Capture : CurrentStep;

    private string StateClass(CheckStep step) =>
        step == DisplayStep ? "is-current" : step < DisplayStep ? "is-done" : "is-upcoming";
}
