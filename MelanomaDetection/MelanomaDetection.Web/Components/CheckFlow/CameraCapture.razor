@* The "Take a photo" tile plus its live in-app viewfinder. Renders the old
   native file-input camera mode instead whenever getUserMedia isn't usable
   (an insecure context, an old browser, or a device with no camera) so
   nobody loses the ability to take a photo -- they just lose the in-app
   preview. *@
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!IsSupported)
{
    <CaptureTile IconName="camera" Variant="primary" Title="Take a photo" Subtitle="Opens the rear camera">
        <InputFile OnChange="OnFileSelected" accept="image/*" capture="environment"
                   class="capture-input" aria-label="Take a photo" />
    </CaptureTile>
}
else
{
    <CaptureTile IconName="camera" Variant="primary" Title="Take a photo" Subtitle="Opens an in-app viewfinder"
                 OnClick="OpenViewfinder" />
}

@if (IsOpen)
{
    @* A native <dialog> opened with showModal(), so it covers the whole screen from the browser's
       top layer: a position:fixed <div> here was trapped inside the check-flow card (its entrance
       animation leaves a transform on it), sat under the site header on phones, and hid the close button. *@
    <dialog class="camera-overlay" aria-modal="true" aria-label="Camera" @ref="OverlayElement" @onkeydown="OnOverlayKeyDown">
        <video @ref="VideoElement" class="camera-video" autoplay playsinline muted></video>
        <canvas @ref="CanvasElement" class="camera-canvas-hidden"></canvas>

        <div class="camera-topbar">
            <button type="button" class="camera-icon-button" @onclick="Close" aria-label="Close camera">
                <AppIcon Name="close" Size="lg" />
            </button>
        </div>

        @if (ErrorMessage is not null)
        {
            <div class="camera-error" role="alert">
                <p>@ErrorMessage</p>
                <button type="button" class="btn btn-outline-primary" @onclick="Close">Close</button>
            </div>
        }
        else
        {
            @if (CaptureMessage is not null)
            {
                <p class="camera-hint" role="status">@CaptureMessage</p>
            }

            <div class="camera-bottombar">
                <button type="button" class="camera-icon-button" @onclick="SwitchCamera"
                        disabled="@IsBusy" aria-label="Switch camera">
                    <AppIcon Name="retry" Size="lg" />
                </button>
                <button type="button" class="camera-shutter" @onclick="Capture"
                        disabled="@IsBusy" aria-label="Take photo"></button>
                <span class="camera-icon-button-spacer" aria-hidden="true"></span>
            </div>
        }
    </dialog>
}

@code {
    /// <summary>Wired to the fallback &lt;InputFile&gt; when getUserMedia isn't usable.</summary>
    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }

    /// <summary>Raised with a JPEG-encoded frame once the person taps the shutter.</summary>
    [Parameter, EditorRequired]
    public EventCallback<byte[]> OnCaptured { get; set; }

    private ElementReference OverlayElement;
    private ElementReference VideoElement;
    private ElementReference CanvasElement;

    // Optimistic default: true so the common case (a modern, secure-context
    // browser) never flashes the file-input fallback before the real check
    // below lands. The rare unsupported case swaps to the fallback tile
    // right after first render instead.
    private bool IsSupported = true;
    private bool IsOpen;
    private bool IsBusy;
    private bool _pendingStart;
    private string _facingMode = "environment";
    private string? ErrorMessage;

    /// <summary>A capture that didn't produce a photo but can simply be retried; unlike
    /// <see cref="ErrorMessage"/> (the camera itself failed) the viewfinder stays open.</summary>
    private string? CaptureMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var supported = await JS.InvokeAsync<bool>("skinCheckCamera.isSupported");
            if (supported != IsSupported)
            {
                IsSupported = supported;
                StateHasChanged();
            }
        }

        if (_pendingStart)
        {
            _pendingStart = false;
            await JS.InvokeVoidAsync("skinCheckCamera.showOverlay", OverlayElement);
            await StartStream();
        }
    }

    private void OpenViewfinder()
    {
        ErrorMessage = null;
        CaptureMessage = null;
        IsOpen = true;
        _pendingStart = true;
    }

    // Escape would close the native dialog on its own and leave the camera running; close it properly.
    private async Task OnOverlayKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task StartStream()
    {
        IsBusy = true;
        StateHasChanged();
        ErrorMessage = await JS.InvokeAsync<string?>("skinCheckCamera.start", VideoElement, _facingMode);
        IsBusy = false;
        StateHasChanged();
    }

    private async Task SwitchCamera()
    {
        _facingMode = _facingMode == "environment" ? "user" : "environment";
        await StartStream();
    }

    private async Task Capture()
    {
        IsBusy = true;
        CaptureMessage = null;
        StateHasChanged();

        byte[]? photo;
        try
        {
            photo = await ReadPhotoAsync();
        }
        catch (Exception ex) when (ex is JSException or IOException or InvalidOperationException or FormatException
            or ArgumentOutOfRangeException)
        {
            photo = null;
            CaptureMessage = "That photo could not be read. Please try again.";
        }

        if (photo is null)
        {
            // Keep the viewfinder open so it can be retried; the stream is still running.
            CaptureMessage ??= "The camera has not produced a picture yet. Wait a moment and try again.";
            IsBusy = false;
            return;
        }

        await JS.InvokeVoidAsync("skinCheckCamera.stop", VideoElement);
        IsOpen = false;
        IsBusy = false;
        await OnCaptured.InvokeAsync(photo);
    }

    /// <summary>
    /// The current frame as JPEG bytes, or null when there was no frame to capture. The bytes
    /// come across as a stream, never as one base64 string: a Blazor Server circuit accepts at
    /// most 32 KB per message from the browser, and a real photo is far larger, so sending it
    /// that way makes the server drop the whole connection (see wwwroot/cameraCapture.js).
    /// </summary>
    private async Task<byte[]?> ReadPhotoAsync()
    {
        // Wait (up to ~2 s) for a real frame; while the camera is still starting there
        // is nothing worth capturing, and the caller then says so.
        if (!await JS.InvokeAsync<bool>("skinCheckCamera.waitForFrame", VideoElement))
        {
            return null;
        }

        await using var reference = await JS.InvokeAsync<IJSStreamReference?>(
            "skinCheckCamera.capture", VideoElement, CanvasElement, InputLimits.ImageMaxBytes);
        if (reference is null)
        {
            return null;
        }

        await using var stream = await reference.OpenReadStreamAsync(InputLimits.ImageMaxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private async Task Close()
    {
        await JS.InvokeVoidAsync("skinCheckCamera.stop", VideoElement);
        IsOpen = false;
        ErrorMessage = null;
        CaptureMessage = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (!IsOpen)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("skinCheckCamera.stop", VideoElement);
        }
        catch (JSDisconnectedException)
        {
            // Circuit is already gone; the browser tears the camera stream down with it.
        }
    }
}
