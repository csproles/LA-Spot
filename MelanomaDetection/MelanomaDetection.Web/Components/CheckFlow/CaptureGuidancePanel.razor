@* Photo quality is most of the accuracy, so this is deliberately shown before
   the camera opens rather than as a tip afterwards. *@

<section class="card-panel guidance-panel">
    <h2 class="panel-title">Get a photo we can read well</h2>
    <ul class="guidance-list">
        @foreach (var tip in Tips)
        {
            <li class="guidance-item">
                <span class="guidance-icon" aria-hidden="true">@tip.Icon</span>
                <span class="guidance-text"><strong>@tip.Headline</strong> @tip.Detail</span>
            </li>
        }
        @if (IsRecheck)
        {
            <li class="guidance-item">
                <span class="guidance-icon" aria-hidden="true">🔁</span>
                <span class="guidance-text">
                    <strong>Match the last photo.</strong>
                    Same distance and angle as before makes the change comparison much more reliable.
                </span>
            </li>
        }
    </ul>
</section>

@code {
    private record Tip(string Icon, string Headline, string Detail);

    private static readonly Tip[] Tips =
    {
        new("☀️", "Bright, indirect light.",
            "Daylight near a window is ideal. Avoid the flash — it washes out colour and adds glare."),
        new("📏", "10–15 cm away, rear camera.",
            "Close enough to fill the frame, far enough to stay in focus. The front camera can't capture the detail needed."),
        new("🎯", "One spot, centred, sharp.",
            "Tap to focus on the spot itself and hold still. Only one lesion in frame."),
        new("🔬", "Include some surrounding skin.",
            "We calibrate size from the fine hair around the spot — without it, the diameter and size-change readings come back as \"not measured\"."),
    };

    /// <summary>Adds the "match your last photo" tip once a spot has history.</summary>
    [Parameter]
    public bool IsRecheck { get; set; }
}
