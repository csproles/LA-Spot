<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <!--
        theme-color-meta must appear before theme.js's <script> tag below: that script runs
        synchronously (no defer) so it can set data-theme before first paint, which means it
        executes while the parser is still partway through <head> - an element declared after
        the script tag doesn't exist in the DOM yet when the script runs, so
        document.getElementById would silently return null and the meta tag would never
        update. Keep this above theme.js, not just above ImportMap/manifest/icons.
    -->
    <meta id="theme-color-meta" name="theme-color" content="#2A3B31" />
    <ResourcePreloader />
    <link rel="preload" href="fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <!-- Utilities only, no Preflight: see Styles/tailwind.css for why. Loaded after
         app.css/Bootstrap so a Tailwind utility class can still win a specificity tie
         when a component opts into one, without resetting anything it doesn't touch. -->
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["MelanomaDetection.Web.styles.css"]" />
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["skip-link.js"]" defer></script>
    <script src="@Assets["cameraCapture.js"]"></script>
    <script src="@Assets["scheduling.js"]"></script>
    <ImportMap Nonce="@Nonce" />
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="LA Spot" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["registerServiceWorker.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The per-request nonce the Content-Security-Policy allows for the framework's inline import map.</summary>
    private string? Nonce => HttpContext?.Items[SecurityHeaders.NonceKey] as string;
}
