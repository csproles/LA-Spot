@* The signed-in person's picture, or their initials when Google didn't send
   one (or it fails to load). Decorative: the name is always printed beside
   it, so the image has an empty alt. *@

@if (!string.IsNullOrEmpty(PictureUrl))
{
    @* no-referrer: Google's avatar CDN returns 403 when a third-party site
       sends a Referer, and there is no reason to tell it where we are. *@
    <img class="user-avatar user-avatar-@Size"
         src="@PictureUrl"
         alt=""
         referrerpolicy="no-referrer"
         loading="lazy" />
}
else
{
    <span class="user-avatar user-avatar-@Size user-avatar-initials" aria-hidden="true">@Initials</span>
}

@code {
    [Parameter]
    public string? PictureUrl { get; set; }

    [Parameter, EditorRequired]
    public string DisplayName { get; set; } = string.Empty;

    /// <summary>"sm" 28px for the nav, "lg" 56px for the account panel.</summary>
    [Parameter]
    public string Size { get; set; } = "sm";

    private string Initials
    {
        get
        {
            var parts = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..1].ToUpperInvariant(),
                _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant(),
            };
        }
    }
}
