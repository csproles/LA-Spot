@* Says what happened when an account-level action or a sign-in attempt ends
   on the sign-in page, where there is no signed-in session to show it in:
   a confirmation (deletion, demo ended) or a problem (Google sign-in failed). *@

@if (Message is not null)
{
    <div class="account-status @(IsProblem ? "account-status-problem" : null)" role="@(IsProblem ? "alert" : "status")">
        <span class="account-status-icon">
            <AppIcon Name="@(IsProblem ? "info" : "check")" Size="lg" />
        </span>
        <p class="account-status-text">@Message</p>
    </div>
}

@code {
    /// <summary>The "status" query value the endpoint redirected with.</summary>
    [Parameter]
    public string? Status { get; set; }

    private string? Message => Status switch
    {
        "account-deleted" => "Your account and all of its data have been deleted.",
        "demo-ended" => "Demo ended. Everything from that session has been erased.",
        "signin-cancelled" => "Sign-in was cancelled. You can try again whenever you're ready.",
        "signin-failed" => "We couldn't finish signing you in with Google. Please try again.",
        "email-unverified" => "Google hasn't verified the email address on that account, so we can't use it. Verify it with Google, then try again.",
        "session-expired" => "That page was out of date. Please try again.",
        _ => null,
    };

    private bool IsProblem => Status is "signin-failed" or "email-unverified" or "session-expired";
}
