@* "Try the demo": a walkthrough account that starts with no spots and is
   erased at sign-out. A form POST like the Google button, so it carries an
   antiforgery token and can only be started from our own page. *@

<form method="post" action="/auth/login/demo" class="demo-signin-form">
    <AntiforgeryToken />
    <input type="hidden" name="intent" value="demo" />
    <button type="submit" class="btn btn-outline-primary demo-signin-button">
        <span class="demo-signin-icon"><AppIcon Name="spots" Size="inherit" /></span>
        Try the demo
    </button>
    <p class="demo-signin-note">
        Explore with an empty account. Nothing you add is kept once you sign out.
    </p>
</form>
