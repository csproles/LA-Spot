@* Sign out is a form POST, not a link: a GET that ends a session can be
   triggered by any page that embeds the URL as an image, and the antiforgery
   token means only our own pages can end one. *@

<form method="post" action="/auth/logout" class="signout-form">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="/login" />
    <button type="submit" class="@ButtonClass">
        <span class="signout-icon">
            <AppIcon Name="logout" Size="inherit" />
        </span>
        <span>@Label</span>
    </button>
</form>

@code {
    /// <summary>Bootstrap button classes for the host's context; the compact nav uses its own look.</summary>
    [Parameter]
    public string ButtonClass { get; set; } = "btn btn-outline-primary";

    /// <summary>"End demo" for a demo session; the endpoint erases that account on the way out.</summary>
    [Parameter]
    public string Label { get; set; } = "Sign out";
}
