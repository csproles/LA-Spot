@* Providers near the entered zip code, pulled live from the NPI Registry. The
   lookup is a network round trip on every search, so it shows placeholder
   cards rather than swapping the panel for a line of text. *@

<div class="provider-panel">
    @if (IsLoading)
    {
        <LoadingRegion Label="@($"Looking up dermatology providers near {RegionLabel}")">
            <div class="provider-loading">
                <SkeletonBlock Width="58%" Height="16px" />
                <ul class="provider-list">
                    @for (var placeholder = 0; placeholder < SkeletonCount; placeholder++)
                    {
                        <ProviderCardSkeleton />
                    }
                </ul>
            </div>
        </LoadingRegion>
    }
    else if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="provider-status">@LoadError</p>
    }
    else if (Providers.Count == 0)
    {
        <p class="provider-status">
            Enter your zip code to see nearby dermatology providers, pulled live from the NPI Registry.
        </p>
    }
    else
    {
        <p class="provider-panel-title">Dermatology providers near @RegionLabel</p>
        <ul class="provider-list">
            @for (var index = 0; index < Providers.Count; index++)
            {
                var providerIndex = index;
                <ProviderCard Provider="Providers[providerIndex]"
                              IsSelected="@(SelectedIndex == providerIndex)"
                              OnSelect="() => OnProviderSelected.InvokeAsync(providerIndex)" />
            }
        </ul>
        <p class="provider-source">
            Source: NPI Registry (CMS). Verify insurance and availability before visiting.
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DermatologyProvider> Providers { get; set; } = Array.Empty<DermatologyProvider>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? LoadError { get; set; }

    [Parameter]
    public string? RegionLabel { get; set; }

    /// <summary>Index into <see cref="Providers"/> of the practice currently shown on the map.</summary>
    [Parameter]
    public int? SelectedIndex { get; set; }

    /// <summary>Raised with the index of the practice the person clicked.</summary>
    [Parameter]
    public EventCallback<int> OnProviderSelected { get; set; }

    [Parameter]
    public int SkeletonCount { get; set; } = 4;
}
