@* The Google Maps surface. Google's script is fetched at runtime, so the
   canvas holds a placeholder until the map has actually drawn -- otherwise
   the page shows a blank grey rectangle with nothing to say it's working. *@
@inject IJSRuntime JS

<div class="map-canvas-frame">
    <div id="@CanvasElementId" class="map-canvas"></div>
    @if (!IsMapReady)
    {
        <div class="map-canvas-placeholder">
            <LoadingRegion Label="Loading the map">
                <SkeletonBlock Width="100%" Height="480px" Shape="card" Tone="media" />
            </LoadingRegion>
        </div>
    }
</div>

<script type="module" src="@Assets["Components/FindCare/MapCanvas.razor.js"]"></script>

@code {
    /// <summary>The id the interop module looks the container up by.</summary>
    public const string CanvasElementId = "skin-check-map";

    [Parameter, EditorRequired]
    public string ApiKey { get; set; } = string.Empty;

    private bool IsMapReady;
    private bool _initStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initStarted || string.IsNullOrWhiteSpace(ApiKey))
        {
            return;
        }

        _initStarted = true;
        try
        {
            await JS.InvokeVoidAsync("skinCheckMap.init", CanvasElementId, ApiKey);
        }
        finally
        {
            IsMapReady = true;
            StateHasChanged();
        }
    }
}
