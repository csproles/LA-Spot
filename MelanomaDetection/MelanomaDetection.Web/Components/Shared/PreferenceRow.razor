@* A settings line whose control is something other than a switch. *@

<div class="preference-row">
    <span class="preference-row-label">@Label</span>
    <div class="preference-row-control">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;
}
