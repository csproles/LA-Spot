@* Renders nothing unless there is something to say, so callers can drop it in
   unconditionally instead of wrapping every API error in an @if. *@

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-danger error-alert" role="alert">@Message</div>
}

@code {
    [Parameter]
    public string? Message { get; set; }
}
