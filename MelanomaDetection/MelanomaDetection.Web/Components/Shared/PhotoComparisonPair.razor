@* Before and after, side by side -- the shape the whole app's "what changed"
   story is told in. *@

<div class="photo-comparison">
    <PhotoFigure Base64="@BeforeBase64" Alt="@BeforeAlt" CaptionText="@BeforeCaption" />
    <span class="photo-comparison-arrow" aria-hidden="true"><AppIcon Name="arrow-right" Size="xl" StrokeWidth="2" /></span>
    <PhotoFigure Base64="@AfterBase64" Alt="@AfterAlt" CaptionText="@AfterCaption" />
</div>

@code {
    [Parameter]
    public string? BeforeBase64 { get; set; }

    [Parameter]
    public string BeforeAlt { get; set; } = "Previous photo";

    [Parameter]
    public string? BeforeCaption { get; set; }

    [Parameter]
    public string? AfterBase64 { get; set; }

    [Parameter]
    public string AfterAlt { get; set; } = "Latest photo";

    [Parameter]
    public string? AfterCaption { get; set; }
}
