@* The eyebrow / title / subtitle block every routed page opens with, plus an
   optional slot for the page's primary action. *@

<header class="page-header">
    <div class="page-header-text">
        @if (!string.IsNullOrEmpty(Eyebrow))
        {
            <p class="page-header-eyebrow">@Eyebrow</p>
        }
        <h1 class="page-header-title page-header-title-@Size">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="page-header-subtitle">@Subtitle</p>
        }
        @if (Details is not null)
        {
            <div class="page-header-details">@Details</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Small uppercase line above the title -- a date or a section name.</summary>
    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>"lg" for the entry pages (Home, Check), "md" for list pages.</summary>
    [Parameter]
    public string Size { get; set; } = "md";

    /// <summary>Richer subtitle content -- counts, inline links -- when a plain string isn't enough.</summary>
    [Parameter]
    public RenderFragment? Details { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
