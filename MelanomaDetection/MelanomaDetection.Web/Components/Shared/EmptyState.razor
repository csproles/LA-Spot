@* "Nothing here yet" panel: what's missing, why it matters, and the one
   action that fills it. Four pages showed this shape with their own copy of
   the styles before it lived here. *@

<div class="card-panel empty-state">
    <span class="empty-state-dog" aria-hidden="true"></span>
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2 class="panel-title empty-state-title">@Title</h2>
    }
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="empty-state-description">@Description</p>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    @if (!string.IsNullOrEmpty(ActionHref))
    {
        <a href="@ActionHref" class="btn btn-primary empty-state-action">@ActionText</a>
    }
</div>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? ActionHref { get; set; }

    [Parameter]
    public string ActionText { get; set; } = "Get started";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
