@* A small "i" trigger that opens a centred explainer card -- for the odd label
   or control that needs more room than a hover title attribute gives, and
   needs to work on touch (no hover) as well as desktop. The card is a native
   <dialog> opened with showModal(), so it sits in the browser's top layer: a
   position:fixed card would be trapped inside any transformed ancestor (the
   cards' entrance animation leaves a transform on them) and drawn under the
   cards after it. *@
@inject IJSRuntime JS

<span class="info-popover">
    <button type="button" class="info-popover-trigger @(HasLabel ? "has-label" : "")" @onclick="Toggle"
            aria-label="@($"More info: {Title}")" aria-expanded="@IsOpen" aria-haspopup="dialog">
        <AppIcon Name="info" Size="sm" />
        @if (HasLabel)
        {
            <span>@Label</span>
        }
    </button>

    @if (IsOpen)
    {
        @* A click on the dimmed backdrop lands on the <dialog> itself, never on the inner card. *@
        <dialog class="info-popover-dialog" role="dialog" aria-modal="true" aria-label="@Title" @ref="Dialog"
                @onclick="Close" @onkeydown="OnKeyDown">
            <div class="info-popover-card" @onclick:stopPropagation="true">
                <div class="info-popover-header">
                    <span class="info-popover-title">@Title</span>
                    <button type="button" class="info-popover-close" @onclick="Close" aria-label="Close">
                        <AppIcon Name="close" Size="md" />
                    </button>
                </div>
                <div class="info-popover-body">
                    @ChildContent
                </div>
            </div>
        </dialog>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional visible text beside the icon, for a trigger people need to notice
    /// (a bare icon is easy to miss). Leave empty for the icon alone.</summary>
    [Parameter]
    public string? Label { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    private bool IsOpen;
    private bool NeedsShow;
    private ElementReference Dialog;

    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);

    private void Toggle()
    {
        IsOpen = !IsOpen;
        NeedsShow = IsOpen;
    }

    private void Close() => IsOpen = false;

    // Escape also closes a native modal dialog on its own; mirror it so the state matches.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!NeedsShow)
        {
            return;
        }

        NeedsShow = false;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
            await module.InvokeVoidAsync("showModal", Dialog);
            await module.DisposeAsync();
        }
        catch (JSException)
        {
            // Without JS the card still renders in place; it just isn't lifted to the top layer.
        }
    }
}
