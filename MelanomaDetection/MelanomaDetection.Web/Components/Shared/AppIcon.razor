@* The app's line-icon set in one place. Icons are decorative by default --
   the surrounding control carries the accessible name -- and inherit their
   colour from the parent, so callers tint them by setting `color` on the
   element they sit in rather than reaching into this component. *@

<svg class="app-icon app-icon-@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @Shape
</svg>

@code {
    /// <summary>One of the names in <see cref="Shapes"/>.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// "sm" 16px, "md" 18px, "lg" 20px, "xl" 22px, "hero" 26px, or "inherit"
    /// to take its size from the parent's font-size -- which is how a caller
    /// sizes an icon responsively without fighting CSS isolation.
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "md";

    [Parameter]
    public double StrokeWidth { get; set; } = 1.8;

    private static readonly Dictionary<string, string> Shapes = new()
    {
