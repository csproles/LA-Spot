@* Traces a saved check's page: the risk band block, the change panel, and the
   pipeline/evidence grids. *@

<div class="analysis-results-skeleton">
    <div class="card-panel analysis-results-skeleton-band">
        <SkeletonBlock Width="180px" Height="13px" />
        <SkeletonBlock Width="120px" Height="34px" />
        <SkeletonBlock Width="82%" Height="13px" />
    </div>

    <div class="card-panel analysis-results-skeleton-panel">
        <SkeletonBlock Width="200px" Height="16px" />
        <div class="analysis-results-skeleton-photos">
            <SkeletonBlock Width="100%" Height="150px" Shape="card" Tone="media" />
            <SkeletonBlock Width="100%" Height="150px" Shape="card" Tone="media" />
        </div>
        <SkeletonLines Lines="2" />
    </div>

    <div class="card-panel analysis-results-skeleton-panel">
        <SkeletonBlock Width="160px" Height="16px" />
        <div class="analysis-results-skeleton-grid">
            @for (var tile = 0; tile < 6; tile++)
            {
                <SkeletonBlock Width="100%" Height="112px" Shape="card" Tone="media" />
            }
        </div>
    </div>
</div>
