@* Traces HistoryCard: a 4:3 photo well over a title row and a date. *@

<div class="history-card-skeleton">
    <div class="history-card-skeleton-media">
        <SkeletonBlock Width="100%" Height="100%" Tone="media" />
    </div>
    <div class="history-card-skeleton-body">
        <div class="history-card-skeleton-top">
            <SkeletonBlock Width="56%" Height="12px" />
            <SkeletonBlock Width="52px" Height="17px" Shape="pill" />
        </div>
        <SkeletonBlock Width="44%" Height="10px" />
    </div>
</div>
