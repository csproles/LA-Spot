@* A paragraph's worth of placeholder lines. The last one is short so the
   block reads as text rather than as a solid slab. *@

<div class="skeleton-lines">
    @for (var line = 0; line < Lines; line++)
    {
        <SkeletonBlock Width="@(line == Lines - 1 ? LastLineWidth : "100%")" Height="@LineHeight" />
    }
</div>

@code {
    [Parameter]
    public int Lines { get; set; } = 3;

    [Parameter]
    public string LineHeight { get; set; } = "12px";

    [Parameter]
    public string LastLineWidth { get; set; } = "62%";
}
