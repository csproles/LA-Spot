@* Traces SpotCard so a list that is still loading occupies exactly the space
   its rows will occupy. *@

<div class="spot-card-skeleton">
    <div class="spot-card-skeleton-main">
        <div class="spot-card-skeleton-heading">
            <SkeletonBlock Width="46%" Height="15px" />
            <SkeletonBlock Width="78px" Height="17px" Shape="pill" />
        </div>
        <SkeletonBlock Width="66%" Height="11px" />
        <SkeletonBlock Width="104px" Height="17px" Shape="pill" />
    </div>
    <SkeletonBlock Width="18px" Height="18px" Shape="circle" />
</div>
