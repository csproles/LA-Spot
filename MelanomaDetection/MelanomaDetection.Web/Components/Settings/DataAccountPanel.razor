@* The person's rights over their data: take a copy of all of it, or erase
   all of it. Export is a checked download (DownloadButton); deletion is a form POST behind a
   second, explicit confirmation because it cannot be undone. *@

<div class="card-panel danger-card">
    <p class="panel-title">Data &amp; account</p>
    <p class="danger-lead">
        Export gives you a PDF report: a cover page with your risk profile, then a
        page for each spot with its ABCD scores, breakdown images and check history.
        Deleting your account erases all of it immediately and cannot be undone.
    </p>

    <div class="danger-actions">
        <DownloadButton Href="/account/report" Label="Export my data (PDF)" BusyLabel="Preparing your PDF…"
                        FileName="@AccountEndpoints.ReportFileName" ContentType="application/pdf"
                        InlineFeedback="false" ResultChanged="result => ExportFeedback = result" />

        @if (!ConfirmingDelete)
        {
            <button type="button" class="btn btn-outline-danger danger-action" @onclick="() => ConfirmingDelete = true">
                <span class="danger-action-icon"><AppIcon Name="trash" Size="inherit" /></span>
                Delete account
            </button>
        }
    </div>

    <FormFeedback Value="ExportFeedback" />

    @if (ReportFailed && ExportFeedback is null)
    {
        <p class="data-report-error" role="alert">
            Your PDF report couldn't be created just now. The report service may still be starting up after an
            update -- try again in a minute. If it keeps happening, the raw data download below still works.
        </p>
    }

    <div class="data-raw-link">
        <span>Need it in a machine-readable format?</span>
        <DownloadButton Variant="link" Href="/account/export" Label="Download the raw data (JSON)" BusyLabel="Preparing…"
                        FileName="@AccountEndpoints.ExportFileName" ContentType="application/json"
                        InlineFeedback="false" ResultChanged="result => RawFeedback = result" />
    </div>
    <FormFeedback Value="RawFeedback" />

    @if (ConfirmingDelete)
    {
        <form method="post" action="/account/delete" class="delete-confirm" aria-labelledby="delete-confirm-title">
            <AntiforgeryToken />
            <p id="delete-confirm-title" class="delete-confirm-title">Delete your account and all of your data?</p>
            <p class="delete-confirm-text">
                This removes your spots, photos, check history, risk profile and
                sign-in record. Consider exporting first. Type <strong>delete</strong> to confirm.
            </p>
            <label class="delete-confirm-label" for="delete-confirmation">Confirmation</label>
            <input id="delete-confirmation" name="confirmation" type="text" class="form-control delete-confirm-input"
                   autocomplete="off" required pattern="[Dd][Ee][Ll][Ee][Tt][Ee]" placeholder="delete" />
            <div class="delete-confirm-actions">
                <button type="submit" class="btn btn-outline-danger">Permanently delete</button>
                <button type="button" class="btn btn-outline-primary" @onclick="() => ConfirmingDelete = false">Keep my account</button>
            </div>
        </form>
    }
</div>

@code {
    private FormFeedback.Feedback? ExportFeedback;
    private FormFeedback.Feedback? RawFeedback;

    /// <summary>True after a report download failed and the endpoint sent the person back here.</summary>
    [Parameter]
    public bool ReportFailed { get; set; }

    private bool ConfirmingDelete;
}
