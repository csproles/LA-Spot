@* Account details that travel with the risk profile. *@

<div class="card-panel">
    <p class="panel-title">Account</p>
    <div class="account-fields">
        <div class="field-group">
            <label class="field-label" for="full-name">Full name</label>
            @if (IsLoading)
            {
                <SkeletonBlock Width="100%" Height="38px" />
            }
            else
            {
                <input id="full-name" type="text" class="form-control" placeholder="Jane Doe"
                       value="@FullName"
                       @oninput="e => FullNameChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string FullName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> FullNameChanged { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }
}
