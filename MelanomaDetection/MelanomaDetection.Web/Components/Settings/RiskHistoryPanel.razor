@* The three yes/no risk factors that shorten recheck intervals. *@

<section class="card-panel">
    <h2 class="panel-title">Your history</h2>
    <ToggleRow Label="Family history of melanoma or skin cancer"
               Description="A parent, sibling, or child who has been diagnosed."
               Value="Profile.FamilyHistory"
               ValueChanged="value => Set(profile => profile.FamilyHistory = value)" />
    <ToggleRow Label="Blistering sunburns"
               Description="One or more severe sunburns, especially in childhood or adolescence."
               Value="Profile.BlisteringSunburns"
               ValueChanged="value => Set(profile => profile.BlisteringSunburns = value)" />
    <ToggleRow Label="More than 50 moles"
               Description="A high mole count is a well-established risk factor on its own."
               Value="Profile.ManyMoles"
               ValueChanged="value => Set(profile => profile.ManyMoles = value)" />
</section>

@code {
    [Parameter, EditorRequired]
    public RiskProfile Profile { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task Set(Action<RiskProfile> mutate)
    {
        mutate(Profile);
        await OnChanged.InvokeAsync();
    }
}
