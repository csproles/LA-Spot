@* Primary navigation: a bottom bar on phones, a sidebar from 860px up. The
   destinations are data rather than five hand-written links so the two
   layouts can never drift apart. *@

<nav class="app-nav" aria-label="Primary">
    <div class="app-nav-brand">
        <a href="/">
            <span class="app-nav-brand-mark" aria-hidden="true"></span>
            <img class="app-nav-brand-logo" src="images/la-spot-logo-on-dark.png" alt="LA Spot" width="1136" height="878" />
        </a>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="app-nav-links">
                @foreach (var destination in Destinations.Where(d => !d.ProviderOnly || CurrentUser.IsProvider(context.User)))
                {
                    <NavLink class="@LinkClass(destination)"
                             href="@destination.Href"
                             Match="@(destination.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        @if (destination.IsPrimary)
                        {
                            <span class="app-nav-primary-mark">
                                <span class="app-nav-icon">
                                    <AppIcon Name="@destination.Icon" Size="inherit" StrokeWidth="2" />
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="app-nav-icon">
                                <AppIcon Name="@destination.Icon" Size="inherit" />
                            </span>
                        }
                        <span class="app-nav-label">@destination.Label</span>
                    </NavLink>
                }
            </div>
            <NavAccountCard />
        </Authorized>
        <NotAuthorized>
            @* Public pages (privacy, terms, not-found) still get the shell; the
               only place to go from them is sign-in. *@
            <div class="app-nav-links">
                <NavLink class="app-nav-link" href="login">
                    <span class="app-nav-icon">
                        <AppIcon Name="person" Size="inherit" />
                    </span>
                    <span class="app-nav-label">Sign in</span>
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private record Destination(string Href, string Icon, string Label, bool IsPrimary = false, bool ProviderOnly = false);

    private static readonly Destination[] Destinations =
    {
        new("", "home", "Home"),
        new("spots", "spots", "My spots"),
        new("check", "camera", "Check", IsPrimary: true),
        new("map", "map", "Find a doctor"),
        new("visits", "clock", "Visits"),
        new("provider", "shield", "Dashboard", ProviderOnly: true),
        new("profile", "person", "Profile"),
    };

    private static string LinkClass(Destination destination) =>
        destination.IsPrimary ? "app-nav-link app-nav-link-primary" : "app-nav-link";
}
