@* The signed-in person at the foot of the desktop sidebar, with sign-out one
   tap away. Hidden in the phone bottom bar, where there is no room and the
   Profile tab carries the same controls. *@
@using System.Security.Claims

<AuthorizeView>
    <div class="nav-account">
        <a class="nav-account-identity" href="/profile" title="Profile">
            <UserAvatar DisplayName="@Name(context.User)" PictureUrl="@Picture(context.User)" />
            <span class="nav-account-name">@Name(context.User)</span>
        </a>
        <SignOutForm ButtonClass="signout-compact" Label="@(CurrentUser.IsDemo(context.User) ? "End demo" : "Sign out")" />
    </div>
</AuthorizeView>

@code {
    private static string Name(ClaimsPrincipal user) => user.Identity?.Name ?? "Account";

    private static string? Picture(ClaimsPrincipal user) => user.FindFirstValue(AppClaimTypes.Picture);
}
