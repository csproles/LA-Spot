@* The shell for pages a person sees before signing in: no navigation to
   places they can't go yet, just the brand and the task in the middle. *@
@inherits LayoutComponentBase

<div class="auth-shell app-background">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content" tabindex="-1" class="auth-main">
        <a class="auth-brand" href="/">
            <span class="auth-brand-mark" aria-hidden="true"></span>
            <span class="auth-brand-logo" role="img" aria-label="LA Spot"></span>
        </a>

        <div class="auth-content">
            @Body
        </div>

        <LegalFooterLinks />
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss this message"><AppIcon Name="close" Size="md" /></button>
</div>
