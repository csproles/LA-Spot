@* Every transformation the photo passes through before it is scored, in
   order. *@

<div class="card-panel">
    <h2 class="panel-title">Pipeline stages</h2>
    <p class="text-muted-small">Every transformation the photo passes through before scoring.</p>
    <div class="pipeline-grid">
        <PipelineTile Label="Original" Base64="@Results.Original" IsJpeg="true" />
        <PipelineTile Label="Median Filter" Base64="@Results.NoiseRemoved" IsJpeg="true" />
        <PipelineTile Label="Bilateral Filter" Base64="@Results.BilateralFiltered" IsJpeg="true" />
        <PipelineTile Label="Hair Removal" Base64="@Results.HairRemoved" IsJpeg="true" />
        <PipelineTile Label="Segmentation" Base64="@Results.Segmentation" />
        <PipelineTile Label="Edge Detection" Base64="@Results.Edges" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;
}
