@* The full pipeline breakdown, collapsed by default. It's a lot of imagery
   and most people only want the headline score, so it stays behind one tap. *@

@if (IsOpen)
{
    <div class="card-panel">
        <button type="button" class="link-button breakdown-collapse" @onclick="() => IsOpen = false">
            Hide full breakdown ▲
        </button>
        <AnalysisBreakdown Results="Results" ProcessingId="@ProcessingId" />
    </div>
}
else
{
    <button type="button" class="card-panel detail-link" @onclick="() => IsOpen = true">
        <span class="detail-link-icon">
            <AppIcon Name="gallery" Size="hero" />
        </span>
        <span class="detail-link-text">
            <span class="detail-link-title">See the full breakdown</span>
            <span class="detail-link-subtitle">
                Every processed image, the ABCD visual evidence, and an optional AI-generated explanation.
            </span>
        </span>
        <span class="detail-link-chevron">
            <AppIcon Name="chevron-right" Size="lg" />
        </span>
    </button>
}

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;

    [Parameter, EditorRequired]
    public string ProcessingId { get; set; } = string.Empty;

    private bool IsOpen;
}
