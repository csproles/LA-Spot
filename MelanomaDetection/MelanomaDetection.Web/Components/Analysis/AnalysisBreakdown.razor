@* Everything behind the headline score: how the photo was processed, what
   each ABCDE number was measured from, and an optional written summary. *@

<div class="breakdown">
    <PipelineStagesPanel Results="Results" />
    <AbcdEvidencePanel Results="Results" />
    <PlainLanguageExplanation ProcessingId="@ProcessingId" />
</div>

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;

    [Parameter, EditorRequired]
    public string ProcessingId { get; set; } = string.Empty;
}
