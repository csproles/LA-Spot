@using System.Text.Json
@using MelanomaDetection.Web.Models
@using MelanomaDetection.Web.Services
@inject ImageProcessingService ImageProcessingService

<div class="breakdown">
    <div class="card-panel">
        <h2 class="panel-title">Pipeline stages</h2>
        <p class="text-muted-small">Every transformation the photo passes through before scoring.</p>
        <div class="pipeline-grid">
            @foreach (var tile in ImageTiles)
            {
                <div class="pipeline-tile">
                    @if (HasImage(tile.Base64))
                    {
                        <img src="@ToDataUrl(tile.Base64!)" alt="@tile.Label" class="pipeline-tile-img" />
                    }
                    else
                    {
                        <div class="pipeline-tile-placeholder">Not cached</div>
                    }
                    <p class="pipeline-tile-label">@tile.Label</p>
                </div>
            }
        </div>
    </div>

    <div class="card-panel">
        <h2 class="panel-title">ABCDE scores &amp; visual evidence</h2>
        <p class="text-muted-small">What each score is actually based on, not just the number.</p>
        <div class="score-grid">
            @foreach (var row in ScoreRows)
            {
                <div class="score-card">
                    @if (HasImage(row.VisualBase64))
                    {
                        <img src="@ToDataUrl(row.VisualBase64!)" alt="@row.Label visualization" class="score-card-img" />
                    }
                    <div class="factor-row">
                        <div class="factor-row-header">
                            <span>@row.Label</span>
                            <span>@(row.Score is null ? "N/A" : $"{row.Score:F1} / 10")</span>
                        </div>
                        @if (row.Score is not null)
                        {
                            <div class="factor-bar-track">
                                <div class="factor-bar-fill factor-bar-@GetFactorBand(row.Score.Value)" style="width:@((row.Score.Value / 10 * 100).ToString("F0"))%"></div>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(row.Detail))
                    {
                        <p class="text-muted-small score-card-detail">@row.Detail</p>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card-panel">
        <h2 class="panel-title">Plain-language explanation</h2>
        @if (Explanation is not null)
        {
            <p class="explanation-text">@Explanation</p>
        }
        else if (ExplanationError is not null)
        {
            <div class="alert alert-danger mb-0">@ExplanationError</div>
        }
        else
        {
            <p class="text-muted-small">
                Get an AI-generated, plain-language summary of these findings. This calls
                an external AI service and is not itself a diagnosis.
            </p>
            <button type="button" class="btn btn-outline-primary" disabled="@IsExplaining" @onclick="GetExplanation">
                @(IsExplaining ? "Generating…" : "Get AI explanation")
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;

    [Parameter, EditorRequired]
    public string ProcessingId { get; set; } = string.Empty;

    private string? Explanation;
    private string? ExplanationError;
    private bool IsExplaining;

    private IEnumerable<(string Label, string? Base64)> ImageTiles => new (string, string?)[]
    {
        ("Original", Results.Original),
        ("Median Filter", Results.NoiseRemoved),
        ("Bilateral Filter", Results.BilateralFiltered),
        ("Hair Removal", Results.HairRemoved),
        ("Segmentation", Results.Segmentation),
        ("Edge Detection", Results.Edges),
    };

    private IEnumerable<(string Label, double? Score, string? VisualBase64, string Detail)> ScoreRows => new (string, double?, string?, string)[]
    {
        ("Asymmetry", Results.AbcdeScores.Asymmetry.Score, Results.AsymmetryVisual,
            GetDetailLine("asymmetry", Results.AbcdeScores.Asymmetry)),
        ("Border Irregularity", Results.AbcdeScores.Border.Score, Results.BorderVisual,
            GetDetailLine("border", Results.AbcdeScores.Border)),
        ("Color Variation", Results.AbcdeScores.Color.Score, Results.ColorVisual,
            GetDetailLine("color", Results.AbcdeScores.Color)),
        ("Diameter", Results.AbcdeScores.Diameter.Score, Results.DiameterVisual,
            GetDetailLine("diameter", Results.AbcdeScores.Diameter)),
        ("Evolving", Results.AbcdeScores.Evolving.Score, null,
            "Not assessable from a single static image."),
    };

    /// <summary>Turns a score's raw "details" JSON into a short, readable caption.</summary>
    private static string GetDetailLine(string criterion, AbcdeScore score)
    {
        var details = score.Details;
        if (details.ValueKind != JsonValueKind.Object)
        {
            return string.Empty;
        }

        switch (criterion)
        {
            case "asymmetry":
                if (details.TryGetProperty("raw_asymmetry_ratio", out var asymRatio))
                {
                    var threshold = details.TryGetProperty("concern_threshold", out var t1) ? t1.GetDouble() : 0.20;
                    return $"Mirror-overlap mismatch ratio: {asymRatio.GetDouble():F2} (concern threshold: {threshold:F2})";
                }
                return string.Empty;

            case "border":
                if (details.TryGetProperty("raw_border_irregularity", out var borderRaw))
                {
                    var threshold = details.TryGetProperty("concern_threshold", out var t2) ? t2.GetDouble() : 0.50;
                    return $"Border irregularity: {borderRaw.GetDouble():F2} (concern threshold: {threshold:F2})";
                }
                return string.Empty;

            case "color":
                var line = string.Empty;
                if (details.TryGetProperty("color_cv", out var cv))
                {
                    line = $"Color variation (CV): {cv.GetDouble():F2}";
                }
                if (details.TryGetProperty("dangerous_colors_pct", out var dangerous) && dangerous.ValueKind == JsonValueKind.Object)
                {
                    var parts = dangerous.EnumerateObject()
                        .Select(p => $"{p.Name.Replace('_', '-')} ({p.Value.GetDouble():P0})")
                        .ToList();
                    if (parts.Count > 0)
                    {
                        line += (line.Length > 0 ? " | " : string.Empty) + $"Dangerous colors detected: {string.Join(", ", parts)}";
                    }
                }
                return line;

            case "diameter":
                if (details.TryGetProperty("diameter_mm", out var mm))
                {
                    return $"≈{mm.GetDouble():F1}mm (hair-calibrated measurement)";
                }
                if (details.TryGetProperty("reason", out var reason))
                {
                    return $"Not measurable: {reason.GetString()}";
                }
                return string.Empty;

            default:
                return string.Empty;
        }
    }

    private static string GetFactorBand(double score) => score switch
    {
        < 3.3 => "low",
        < 6.6 => "moderate",
        _ => "high",
    };

    private static bool HasImage(string? base64) => !string.IsNullOrEmpty(base64);

    private static string ToDataUrl(string base64Png) => $"data:image/png;base64,{base64Png}";

    /// <summary>
    /// Triggered only by the "Get AI Explanation" button click -- never called
    /// automatically -- since each first request for a given ProcessingId costs a
    /// real OpenAI API call on the Flask side (subsequent clicks for the same id
    /// are served from Flask's server-side cache).
    /// </summary>
    private async Task GetExplanation()
    {
        IsExplaining = true;
        ExplanationError = null;
        StateHasChanged();

        try
        {
            Explanation = await ImageProcessingService.ExplainAsync(ProcessingId);
        }
        catch (ImageProcessingApiException ex)
        {
            ExplanationError = ex.Message;
        }
        finally
        {
            IsExplaining = false;
        }
    }
}
