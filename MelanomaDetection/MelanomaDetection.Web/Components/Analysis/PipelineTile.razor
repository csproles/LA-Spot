@* One stage of the image pipeline. Stages are only cached for the session, so
   a tile can legitimately have no image to show. *@

<div class="pipeline-tile">
    @if (ImageData.HasImage(Base64))
    {
        <img src="@ImageData.Url(Base64!, IsJpeg)" alt="@Label" class="pipeline-tile-img" />
    }
    else
    {
        <div class="pipeline-tile-placeholder">Not cached</div>
    }
    <p class="pipeline-tile-label">@Label</p>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Base64 { get; set; }

    [Parameter]
    public bool IsJpeg { get; set; }
}
