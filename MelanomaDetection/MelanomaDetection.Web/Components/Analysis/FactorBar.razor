@* One 0-10 measurement: its name, its value, and a track filled to match.
   A null score means the pipeline could not measure it, which is different
   from measuring zero -- so the bar is omitted rather than drawn empty. *@

<div class="factor-row">
    <div class="factor-row-header">
        <span class="factor-row-label">@Label</span>
        <span class="factor-row-value">@(Score is null ? "N/A" : $"{Score:F1} / 10")</span>
    </div>
    @if (Score is not null)
    {
        <div class="factor-bar-track">
            <div class="factor-bar-fill factor-bar-@RiskBands.FactorBand(Score.Value)"
                 style="width:@PercentWidth"></div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Detail))
    {
        <p class="factor-row-detail" title="@DetailTooltip">@Detail</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public double? Score { get; set; }

    /// <summary>The raw measurement behind the score, when it's worth showing.</summary>
    [Parameter]
    public string? Detail { get; set; }

    /// <summary>Optional extended explanation shown as a hover tooltip on
    /// Detail -- for cases (diameter's px/relative-size display) that need
    /// more room than the one-line caption has. Empty/null for every other
    /// criterion, which renders no title attribute.</summary>
    [Parameter]
    public string? DetailTooltip { get; set; }

    private string PercentWidth =>
        $"{(Score!.Value / 10 * 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)}%";
}
