@* The "E" in ABCDE: what changed since this spot's previous photo. Degrades
   to a "first photo" state when there is nothing to compare against, because
   that is the common case and it is not an error. *@

@if (Results.SpotId is not null)
{
    <div class="card-panel change-panel">
        <h2 class="panel-title">Change since last check</h2>

        @if (Score is null)
        {
            <div class="change-empty">
                <span class="change-empty-icon">
                    <AppIcon Name="clock" Size="hero" />
                </span>
                <div>
                    <p class="change-empty-title">
                        @(Details.HasPriorCheck ? "Couldn't compare these two photos" : "First photo of this spot")
                    </p>
                    <p class="change-empty-body">
                        @(Details.HasPriorCheck
                            ? Details.Text("reason") ?? "The two photos didn't have enough in common to measure change."
                            : "Change over time is the strongest melanoma warning sign. Photograph this spot again in a few weeks and we'll compare the two.")
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="change-photos">
                <PhotoComparisonPair BeforeBase64="@Results.PriorThumbnail"
                                     BeforeAlt="Previous photo of this spot"
                                     BeforeCaption="@BeforeCaption"
                                     AfterBase64="@Results.Original"
                                     AfterAlt="This photo"
                                     AfterCaption="Now" />
            </div>

            <div class="change-score">
                <FactorBar Label="Evolving score" Score="Score" />
            </div>

            <ul class="change-signals">
                @if (Details.Number("shape_change") is { } shape)
                {
                    <ChangeSignal Name="Shape" Value="@($"{shape * 100:F0}% different outline")"
                                  Tone="@EvolutionDetails.Tone(shape, Details.Number("shape_concern_threshold") ?? 0.25)" />
                }
                @if (Details.Number("color_distance") is { } color)
                {
                    <ChangeSignal Name="Colour" Value="@($"{color:F0} ΔE shift")"
                                  Tone="@EvolutionDetails.Tone(color, Details.Number("color_concern_threshold") ?? 12)" />
                }
                @if (Details.Number("area_growth_ratio") is { } growth)
                {
                    <ChangeSignal Name="Size" Value="@GrowthText(growth)"
                                  Tone="@EvolutionDetails.Tone(Math.Max(growth, 0), Details.Number("growth_concern_threshold") ?? 0.3)" />
                }
                else
                {
                    <ChangeSignal Name="Size" Tone="unavailable"
                                  Value="@(Details.Text("size_note") ?? "Not measured")" />
                }
                @if (Details.Number("risk_score_delta") is { } delta)
                {
                    <ChangeSignal Name="Risk score" Value="@($"{(delta >= 0 ? "+" : "")}{delta:F0} points")"
                                  Tone="@(delta >= 5 ? "concern" : delta <= -5 ? "improved" : "stable")" />
                }
            </ul>

            <p class="change-caveat">
                Compared from two phone photos without a fixed distance or lighting, so treat this as a
                change indicator to raise with a clinician, not a measurement.
                @if (Score >= 5)
                {
                    <strong>This spot has changed noticeably. Consider having a dermatologist look at it.</strong>
                }
            </p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;

    private double? Score => Results.AbcdeScores.Evolving.Score;

    private EvolutionDetails Details => new(Results.AbcdeScores.Evolving.Details);

    private string BeforeCaption
    {
        get
        {
            var when = Details.Text("compared_with_at");
            return when is not null && DateTimeOffset.TryParse(when, out var at)
                ? $"Before · {at.ToLocalTime():MMM d, yyyy}"
                : "Before";
        }
    }

    private string GrowthText(double growth)
    {
        var sign = growth >= 0 ? "+" : string.Empty;
        var change = $"{sign}{growth * 100:F0}% area";
        var before = Details.Number("prior_area_mm2");
        var after = Details.Number("area_mm2");
        return before is null || after is null
            ? change
            : $"{change} ({before:F1} → {after:F1} mm²)";
    }
}
