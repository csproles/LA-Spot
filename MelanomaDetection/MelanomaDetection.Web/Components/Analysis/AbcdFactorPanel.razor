@* The four ABCD measurements as bars. Evolving is deliberately absent: it
   compares two photos rather than measuring this one, and it gets its own
   panel. *@

<div class="card-panel">
    <h2 class="panel-title">What we looked at</h2>
    <FactorBar Label="Shape symmetry" Score="Scores.Asymmetry.Score" Detail="Do both halves match?" />
    <FactorBar Label="Border regularity" Score="Scores.Border.Score" Detail="Is the edge smooth and even?" />
    <FactorBar Label="Color variation" Score="Scores.Color.Score" Detail="Is it one color, or several?" />
    <FactorBar Label="Diameter" Score="Scores.Diameter.Score" Detail="How wide is it?" />
</div>

@code {
    [Parameter, EditorRequired]
    public AbcdeScores Scores { get; set; } = null!;
}
