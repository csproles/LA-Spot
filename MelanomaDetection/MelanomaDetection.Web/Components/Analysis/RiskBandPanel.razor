@* The headline verdict for a check: V5's own overall_visual_concern result
   (LOWER/ELEVATED VISUAL CONCERN), not a band cut on the 0-100 score -- see
   Services/VisualConcern.cs for why. The score is still shown, but as a
   secondary, clearly-labeled number: a model decision score, not a
   probability of melanoma or any diagnosis. *@

<div class="card-panel risk-band risk-band-@Tone">
    <p class="risk-band-label">@VisualConcern.Label(OverallVisualConcern)</p>
    <p class="risk-band-recommendation">@VisualConcern.Guidance(OverallVisualConcern)</p>

    <div class="risk-band-score-block">
        <p class="risk-band-score">@Score.ToString("F0") <span class="risk-band-score-total">/100</span></p>
        <p class="risk-band-score-caption">
            Model decision score -- not a probability of melanoma, not a diagnosis.
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public double Score { get; set; }

    /// <summary>
    /// V5's own result: "LOWER VISUAL CONCERN", "ELEVATED VISUAL CONCERN", or
    /// null if no lesion was detected (or this check predates the field).
    /// </summary>
    [Parameter]
    public string? OverallVisualConcern { get; set; }

    private string Tone => VisualConcern.CssTone(OverallVisualConcern);
}
