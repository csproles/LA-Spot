@* Shown only when YOLO detected more than one lesion instance in the photo.
   Makes clear that only the highlighted primary spot was analyzed -- the
   others were detected but not scored, so nothing here should read as "all
   of these were checked." Never implies a spot YOLO didn't detect was
   analyzed: only outlines MultiInstanceOverlay actually contains. *@

@if (Results.MultiLesionDetected)
{
    <div class="card-panel multi-lesion-notice">
        <p class="multi-lesion-notice-text">
            Multiple spots detected (@Results.NumLesionInstances). The highlighted primary spot is used
            for the current visual-concern analysis.
        </p>
        @if (ImageData.HasImage(Results.MultiInstanceOverlay))
        {
            <img src="@ImageData.PngUrl(Results.MultiInstanceOverlay!)" alt="All detected spots, primary highlighted"
                 class="multi-lesion-notice-img" />
            <ul class="multi-lesion-notice-legend">
                <li><span class="legend-swatch legend-swatch-primary"></span> Primary spot -- analyzed above</li>
                <li><span class="legend-swatch legend-swatch-other"></span> Also detected, not analyzed</li>
            </ul>
        }
        <p class="multi-lesion-notice-caveat">
            Only spots this photo's automated detection actually found are outlined here -- a spot that
            isn't outlined wasn't detected, and wasn't analyzed either way. If you want another spot
            checked, photograph it on its own as a separate check.
        </p>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ImageProcessingResults Results { get; set; } = null!;
}
