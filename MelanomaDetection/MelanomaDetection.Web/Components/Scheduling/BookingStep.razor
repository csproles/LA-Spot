@* One collapsible step of the booking flow. The header is a button; collapsed, it shows the choice made in that step. *@

<section class="booking-step @(Embedded ? "is-embedded" : "card-panel") @(IsOpen ? "is-open" : "") @(IsComplete ? "is-complete" : "")">
    @if (Embedded)
    {
        <h3 class="booking-step-heading is-small">@Toggle</h3>
    }
    else
    {
        <h2 class="booking-step-heading">@Toggle</h2>
    }
    @if (IsOpen)
    {
        <div class="booking-step-body" id="@BodyId">
            @ChildContent
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public int Number { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool Optional { get; set; }

    /// <summary>Shown under the title while collapsed, e.g. the provider or time already picked.</summary>
    [Parameter]
    public string? Summary { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsComplete { get; set; }

    [Parameter]
    public bool Embedded { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment Toggle => @<button type="button" class="booking-step-toggle" aria-expanded="@(IsOpen ? "true" : "false")"
                                               aria-controls="@BodyId" @onclick="OnToggle">
        <span class="booking-step-number" aria-hidden="true">@(IsComplete && !IsOpen ? "✓" : Number.ToString())</span>
        <span class="booking-step-text">
            <span class="booking-step-title">
                @Title
                @if (Optional)
                {
                    <span class="booking-step-optional">(optional)</span>
                }
            </span>
            @if (!IsOpen && !string.IsNullOrEmpty(Summary))
            {
                <span class="booking-step-summary">@Summary</span>
            }
        </span>
        <span class="booking-step-chevron" aria-hidden="true"><AppIcon Name="chevron-right" Size="sm" /></span>
    </button>;

    private readonly string BodyId = $"booking-step-{Guid.NewGuid():N}";
}
