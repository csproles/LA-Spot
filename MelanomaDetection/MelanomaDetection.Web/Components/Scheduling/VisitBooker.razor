@* The whole booking flow -- pick a provider, pick an open time, add a reason, book,
   confirmation -- shared by the Book a visit page and the Find a doctor map box, so
   both go through the same AvailabilityService/BookingService and can't drift apart.
   Embedded drops the per-step cards (the host supplies one card) and steps the
   headings down a level. ScanQuery/ScanResult are only passed by the Book a visit
   page, when someone arrives from a scan result. *@
@inject AvailabilityService Availability
@inject BookingService Booking
@inject ImageProcessingService ImageProcessingService
@inject CurrentUser CurrentUser
@inject IJSRuntime JS

<div class="visit-booker @(Embedded ? "is-embedded" : "")">
    @if (SelectedProvider is null)
    {
        <ErrorAlert Message="@LoadError" />
    }

    @if (BookedProviderName is not null && BookedStartUtc is not null)
    {
        <div class="@(Embedded ? "" : "card-panel") book-visit-confirmation" role="status">
            @if (Embedded)
            {
                <h3 class="panel-title">Visit booked</h3>
            }
            else
            {
                <h2 class="panel-title">Visit booked</h2>
            }
            <p>With @BookedProviderName, @FormatSlotFull(BookedStartUtc.Value).</p>
            <div class="book-visit-confirmation-actions">
                <a href="@($"/video/{BookedAppointmentId}")" class="btn btn-outline-primary">Join call now</a>
                <a href="/visits" class="btn btn-primary">See my visits</a>
            </div>
        </div>

        @if (ShowConfirmedDialog)
        {
            <BookingConfirmedDialog ProviderName="@BookedProviderName" When="@FormatSlotFull(BookedStartUtc.Value)"
                                    SharedHealthData="BookedWithSharedData" OnClose="() => ShowConfirmedDialog = false" />
        }
    }
    else
    {
        <BookingStep Number="1" Title="Choose a provider" Embedded="Embedded"
                     IsOpen="IsProviderStepOpen" IsComplete="SelectedProvider is not null" Summary="@SelectedProvider?.DisplayName"
                     OnToggle="() => IsProviderStepOpen = !IsProviderStepOpen">
            @if (IsLoadingProviders)
            {
                <SkeletonBlock Height="48px" Shape="pill" />
            }
            else if (Providers.Count == 0)
            {
                <EmptyState Title="No providers available yet" Description="Check back soon -- providers are added by the clinic." />
            }
            else
            {
                @if (NearRegion is not null)
                {
                    <p class="visit-booker-note">
                        Doctors closest to @(string.IsNullOrWhiteSpace(NearPlaceName) ? NearRegion.CityLabel : NearPlaceName), LA are listed first.
                        All visits are by video.
                    </p>
                }
                else if (Embedded)
                {
                    <p class="visit-booker-note">Enter your zip code above to see the doctors closest to you. All visits are by video.</p>
                }

                <div class="choice-grid">
                    @foreach (var provider in OrderedProviders)
                    {
                        <ChoiceCard Layout="column" Selected="@(SelectedProvider?.Id == provider.Id)"
                                    OnSelect="() => SelectProviderAsync(provider)">
                            <strong>@provider.DisplayName</strong>
                            <span>@(string.IsNullOrWhiteSpace(provider.Credentials) ? provider.Specialty : provider.Credentials)</span>
                            @if (!string.IsNullOrWhiteSpace(provider.HubCity))
                            {
                                <span class="provider-card-city">@provider.HubCity@(IsClosest(provider) ? " (closest to you)" : "")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(provider.Bio))
                            {
                                <span class="provider-card-bio">@provider.Bio</span>
                            }
                        </ChoiceCard>
                    }
                </div>
            }
        </BookingStep>

        @if (SelectedProvider is not null)
        {
            <BookingStep Number="2" Title="Choose a time" Embedded="Embedded"
                         IsOpen="IsTimeStepOpen" IsComplete="SelectedSlotUtc is not null"
                         Summary="@(SelectedSlotUtc is { } picked ? FormatSlotFull(picked) : null)"
                         OnToggle="() => IsTimeStepOpen = !IsTimeStepOpen">
                <ErrorAlert Message="@LoadError" />
                <div class="week-nav">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            disabled="@(WeekStart <= MinDate)" @onclick="() => ChangeWeekAsync(-7)">
                        <AppIcon Name="chevron-left" Size="sm" /> Prev week
                    </button>
                    <span class="week-nav-label">@WeekStart.ToString("MMM d") - @WeekStart.AddDays(6).ToString("MMM d")</span>
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            disabled="@(WeekStart.AddDays(7) > MaxDate)" @onclick="() => ChangeWeekAsync(7)">
                        Next week <AppIcon Name="chevron-right" Size="sm" />
                    </button>
                </div>

                <div class="week-grid">
                    @foreach (var day in WeekDays)
                    {
                        <div class="week-day-column">
                            <div class="week-day-header">
                                <span>@day.ToString("ddd")</span>
                                <strong>@day.Day</strong>
                            </div>
                            @if (IsLoadingSlots)
                            {
                                <SkeletonBlock Height="30px" Shape="pill" />
                            }
                            else
                            {
                                var daySlots = SlotsForDay(day);
                                if (daySlots.Count == 0)
                                {
                                    <span class="week-day-empty">No slots</span>
                                }
                                else
                                {
                                    @foreach (var slot in daySlots)
                                    {
                                        <button type="button" class="week-slot-btn @(SelectedSlotUtc == slot ? "is-selected" : "")"
                                                @onclick="() => SelectSlot(slot)">
                                            @FormatSlotTime(slot)
                                        </button>
                                    }
                                }
                            }
                        </div>
                    }
                </div>
            </BookingStep>
        }

        @if (SelectedSlotUtc is not null)
        {
            <BookingStep Number="3" Title="Visit details" Optional="true" Embedded="Embedded"
                         IsOpen="IsDetailsStepOpen" IsComplete="true" Summary="@DetailsSummary"
                         OnToggle="() => IsDetailsStepOpen = !IsDetailsStepOpen">
                <label class="visit-booker-field" for="@ReasonId">What's this about?</label>
                <textarea id="@ReasonId" class="form-control" rows="3" maxlength="500" @bind="Reason" @bind:event="oninput"
                          placeholder="A new spot, a follow-up, etc."></textarea>

                @if (ScanResult is not null)
                {
                    <label class="book-visit-scan-toggle">
                        <input type="checkbox" @bind="AttachScan" />
                        <span>Share the @ScanResult.OverallVisualConcern result (score @ScanResult.RiskScore.ToString("F0")/100) and its AI explanation with @SelectedProvider!.DisplayName</span>
                    </label>
                }
                else if (ScanLoadError is not null)
                {
                    <p class="text-muted-small">@ScanLoadError</p>
                }

                <label class="book-visit-scan-toggle">
                    <input type="checkbox" checked="@ShareHealthData" @onchange="OnShareHealthDataChanged" />
                    <span>
                        Share my health data with @SelectedProvider!.DisplayName for this visit -- my risk profile, spots and
                        check history with photos (the same as "Export my data"). They can see it until the visit ends or is cancelled.
                    </span>
                </label>
            </BookingStep>

            <div class="@(Embedded ? "visit-booker-step" : "card-panel") book-visit-footer">
                <p class="book-visit-summary">
                    @SelectedProvider!.DisplayName, @FormatSlotFull(SelectedSlotUtc.Value)
                </p>
                <button type="button" class="btn btn-primary book-visit-submit" disabled="@IsBooking" @onclick="SubmitBookingAsync">
                    @if (IsBooking)
                    {
                        <span class="btn-spinner" aria-hidden="true"></span>
                    }
                    Book this visit
                </button>
            </div>
        }
    }
</div>

@code {
    /// <summary>The scan result the visit came from, if any -- only the Book a visit page sets these.</summary>
    [Parameter]
    public string? ScanQuery { get; set; }

    [Parameter]
    public ImageProcessingResults? ScanResult { get; set; }

    [Parameter]
    public string? ScanLoadError { get; set; }

    /// <summary>True inside another card (the map's booking box): no per-step cards, smaller headings.</summary>
    [Parameter]
    public bool Embedded { get; set; }

    /// <summary>The hub city nearest the visitor's zip code (a name from LouisianaRegions), set by the
    /// Find a doctor page after a zip search. Doctors in or nearest that city are listed first.</summary>
    [Parameter]
    public string? NearHubCity { get; set; }

    /// <summary>The zip code's place name, for the note above the doctors. Optional.</summary>
    [Parameter]
    public string? NearPlaceName { get; set; }

    private LouisianaRegions.Region? NearRegion => LouisianaRegions.FindHub(NearHubCity);

    /// <summary>Everyone, closest hub city first (then by name). Doctors with no city come last,
    /// and with no zip code the list stays in the order it was loaded.</summary>
    private IEnumerable<ProviderSummary> OrderedProviders
    {
        get
        {
            var near = NearRegion;
            if (near is null)
            {
                return Providers;
            }

            return Providers
                .OrderBy(p => LouisianaRegions.FindHub(p.HubCity) is { } hub ? LouisianaRegions.MilesBetween(near, hub) : double.MaxValue)
                .ThenBy(p => p.DisplayName, StringComparer.Ordinal);
        }
    }

    private bool IsClosest(ProviderSummary provider) =>
        NearRegion is { } near && string.Equals(provider.HubCity, near.CityLabel, StringComparison.OrdinalIgnoreCase);

    private List<ProviderSummary> Providers = [];
    private bool IsLoadingProviders = true;
    private ProviderSummary? SelectedProvider;

    private DateOnly MinDate;
    private DateOnly MaxDate;
    private DateOnly WeekStart;
    private bool IsLoadingSlots;
    private List<DateTime> Slots = [];
    private DateTime? SelectedSlotUtc;

    private bool IsProviderStepOpen = true;
    private bool IsTimeStepOpen;
    private bool IsDetailsStepOpen;
    private bool ShowConfirmedDialog;
    private bool BookedWithSharedData;
    private readonly string ReasonId = $"visit-reason-{Guid.NewGuid():N}";

    private string DetailsSummary
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(Reason))
            {
                parts.Add("Reason added");
            }

            if (AttachScan && ScanResult is not null)
            {
                parts.Add("sharing your scan");
            }

            if (ShareHealthData)
            {
                parts.Add("sharing your health data");
            }

            return parts.Count == 0 ? "Nothing added" : string.Join(" · ", parts);
        }
    }

    private bool AttachScan = true;
    private bool ShareHealthData;
    private bool ShareHealthDataTouched;

    private string? Reason;
    private bool IsBooking;
    private string? LoadError;
    private string? BookedProviderName;
    private DateTime? BookedStartUtc;
    private Guid BookedAppointmentId;

    private Guid? PatientId;
    private string? BrowserTimeZoneId;

    private IEnumerable<DateOnly> WeekDays => Enumerable.Range(0, 7).Select(WeekStart.AddDays);

    protected override async Task OnInitializedAsync()
    {
        SetToday(BrowserTimeZoneId);
        WeekStart = MinDate;

        PatientId = await CurrentUser.GetUserIdAsync();
        _ = LoadSharePreferenceAsync();

        try
        {
            Providers = [.. await Availability.ListProvidersAsync()];
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            LoadError = "Couldn't load providers. Try again in a moment.";
        }
        finally
        {
            IsLoadingProviders = false;
        }

        // Nothing to choose between -- go straight to the open times.
        if (Providers.Count == 1)
        {
            await SelectProviderAsync(Providers[0]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // Best-effort: if JS interop isn't available yet, times just stay in UTC.
            BrowserTimeZoneId = await JS.InvokeAsync<string>("skinCheckScheduling.getTimeZone");
        }
        catch (JSException)
        {
            return;
        }

        // The calendar opened on UTC's date; move it to the visitor's own today so an
        // evening visitor west of UTC still sees (and can book) the rest of today.
        var startedOnFirstWeek = WeekStart == MinDate;
        SetToday(BrowserTimeZoneId);
        if (startedOnFirstWeek && WeekStart != MinDate)
        {
            WeekStart = MinDate;
            SelectedSlotUtc = null;
            await LoadSlotsAsync();
        }

        StateHasChanged();
    }

    private void SetToday(string? timeZoneId)
    {
        MinDate = DateOnly.FromDateTime(ClientTimeZone.ToLocal(DateTime.UtcNow, timeZoneId));
        MaxDate = MinDate.AddDays(30);
    }

    /// <summary>Pre-fills the share box from the profile's "Share with my dermatologist" choice
    /// without holding up the provider list, and never overrides a box the patient already clicked.</summary>
    private async Task LoadSharePreferenceAsync()
    {
        try
        {
            var preference = (await ImageProcessingService.GetProfileAsync()).ShareWithDermatologist;
            if (!ShareHealthDataTouched)
            {
                ShareHealthData = preference;
                StateHasChanged();
            }
        }
        catch (ImageProcessingApiException)
        {
        }
    }

    private void OnShareHealthDataChanged(ChangeEventArgs e)
    {
        ShareHealthDataTouched = true;
        ShareHealthData = e.Value is true;
    }

    private async Task SelectProviderAsync(ProviderSummary provider)
    {
        SelectedProvider = provider;
        SelectedSlotUtc = null;
        IsProviderStepOpen = false;
        IsTimeStepOpen = true;
        IsDetailsStepOpen = false;
        WeekStart = MinDate;
        await LoadSlotsAsync();
    }

    private void SelectSlot(DateTime slot)
    {
        SelectedSlotUtc = slot;
        IsTimeStepOpen = false;
        IsDetailsStepOpen = true;
    }

    private async Task ChangeWeekAsync(int deltaDays)
    {
        var next = WeekStart.AddDays(deltaDays);
        if (next < MinDate || next > MaxDate)
        {
            return;
        }

        WeekStart = next;
        SelectedSlotUtc = null;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        if (SelectedProvider is null)
        {
            return;
        }

        IsLoadingSlots = true;
        LoadError = null;
        StateHasChanged();

        try
        {
            // A day of padding each side: the grid is in the visitor's timezone but the range is
            // read in the provider's, so edge-of-day slots could otherwise fall outside it.
            // Past times are already dropped, so today's remaining slots are all still offered.
            Slots = [.. await Availability.GetOpenSlotsUtcAsync(SelectedProvider.Id, WeekStart.AddDays(-1), WeekStart.AddDays(7))];
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            LoadError = "Couldn't load open times. Try again.";
            Slots = [];
        }
        finally
        {
            IsLoadingSlots = false;
        }
    }

    /// <summary>Slots on this calendar day, in the visitor's own timezone (falls back to UTC
    /// until the browser's zone id arrives -- see OnAfterRenderAsync).</summary>
    private List<DateTime> SlotsForDay(DateOnly day) =>
        [.. Slots.Where(s => DateOnly.FromDateTime(ClientTimeZone.ToLocal(s, BrowserTimeZoneId)) == day).OrderBy(s => s)];

    private async Task SubmitBookingAsync()
    {
        if (SelectedProvider is null || SelectedSlotUtc is null || PatientId is null || IsBooking)
        {
            return;
        }

        IsBooking = true;
        LoadError = null;
        StateHasChanged();

        var reason = string.IsNullOrWhiteSpace(Reason) ? null : Reason.Trim();

        AttachedScan? scan = null;
        if (AttachScan && ScanResult is not null && !string.IsNullOrWhiteSpace(ScanQuery))
        {
            string? explanation = null;
            try
            {
                // Best-effort: Flask caches this per processingId, so if the patient
                // already generated it viewing their results this just re-reads the
                // cache. A booking is worth the (possibly first) generation cost either way.
                explanation = await ImageProcessingService.ExplainAsync(ScanQuery);
            }
            catch (ImageProcessingApiException)
            {
            }

            scan = new AttachedScan(ScanQuery, ScanResult.RiskScore, ScanResult.OverallVisualConcern, explanation);
        }

        var result = await Booking.BookAsync(SelectedProvider.Id, PatientId.Value, SelectedSlotUtc.Value, reason, scan, ShareHealthData);

        IsBooking = false;
        if (result.Outcome == BookingOutcome.Booked)
        {
            BookedProviderName = SelectedProvider.DisplayName;
            BookedStartUtc = SelectedSlotUtc;
            BookedAppointmentId = result.Appointment!.Id;
            BookedWithSharedData = ShareHealthData;
            ShowConfirmedDialog = true;
        }
        else
        {
            // Someone else took it between us loading the list and clicking Book --
            // refresh so the taken slot disappears rather than leaving it clickable.
            // LoadSlotsAsync clears LoadError as it starts, so the message goes up after it
            // (unless the reload itself failed, whose error is the more useful one).
            SelectedSlotUtc = null;
            IsTimeStepOpen = true;
            await LoadSlotsAsync();
            LoadError ??= "That time was just booked by someone else. Pick another.";
        }
    }

    private string FormatSlotTime(DateTime slotUtc) => ClientTimeZone.Format(slotUtc, BrowserTimeZoneId, "h:mm tt");

    private string FormatSlotFull(DateTime slotUtc) => ClientTimeZone.Format(slotUtc, BrowserTimeZoneId, "dddd, MMM d 'at' h:mm tt");
}
