@* The four numbers that answer "how am I doing?" at a glance. *@

<div class="stat-row">
    <DashboardStatTile IsLoading="IsLoading"
                       Value="@Spots.Count.ToString()"
                       Label="@(Spots.Count == 1 ? "spot tracked" : "spots tracked")" />

    <DashboardStatTile IsLoading="IsLoading"
                       Attention="@(DueCount > 0)"
                       Value="@DueCount.ToString()"
                       Label="due for recheck" />

    <DashboardStatTile IsLoading="IsLoading"
                       Value="@TotalChecks.ToString()"
                       Label="@(TotalChecks == 1 ? "check saved" : "checks saved")" />

    <DashboardStatTile IsLoading="IsLoading"
                       Tone="@HighestRiskTone"
                       Value="@(HighestRisk?.ToString("F0") ?? "—")"
                       Label="@(HighestRisk is null ? "no scores yet" : "highest risk score")" />
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Spot> Spots { get; set; } = Array.Empty<Spot>();

    [Parameter]
    public bool IsLoading { get; set; }

    private int DueCount => Spots.Count(spot => spot.IsDue);

    private int TotalChecks => Spots.Sum(spot => spot.CheckCount);

    private double? HighestRisk => Spots
        .Where(spot => spot.LastRiskScore is not null)
        .Max(spot => spot.LastRiskScore);

    /// <summary>Coloured by whether any spot's own authoritative concern is
    /// elevated -- NEVER by a band cut on HighestRisk itself, so this tile
    /// can't show a calm colour while a spot the results page called
    /// "Elevated" sits in the list (V4/V5 never produce a "moderate" concern,
    /// so there is no middle tone to represent here).</summary>
    private string HighestRiskTone
    {
        get
        {
            if (HighestRisk is null)
            {
                return "muted";
            }
            return Spots.Any(spot => spot.LastOverallVisualConcern == VisualConcern.Elevated) ? "high" : "low";
        }
    }
}
