@* Shown until the risk profile is filled in: the answers change how often
   every spot is due, so the prompt is worth a card of its own. *@

<a href="/onboarding" class="card-panel setup-card">
    <span class="setup-card-icon">
        <AppIcon Name="person" Size="xl" />
    </span>
    <span class="setup-card-text">
        <span class="setup-card-title">Tell us about your skin</span>
        <span class="setup-card-subtitle">
            Answer four quick questions and we can suggest how often to check each spot. It takes about a minute.
        </span>
    </span>
    <span class="setup-card-chevron">
        <AppIcon Name="chevron-right" Size="lg" />
    </span>
</a>
