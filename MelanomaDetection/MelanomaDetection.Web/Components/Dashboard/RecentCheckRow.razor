@* The last few saved checks, newest first, as thumbnail rows. *@

<li>
    <a href="/results/@Entry.ProcessingId" class="recent-item">
        <img src="@ImageData.PngUrl(Entry.Thumbnail)" alt="" class="recent-thumb" />
        <span class="recent-text">
            <span class="recent-title">@(Entry.SpotLabel ?? "Unfiled check")</span>
            <span class="recent-meta">@Entry.Location · @Recheck.Ago(Entry.ProcessedAt)</span>
        </span>
        <RiskScoreBadge Score="Entry.RiskScore" Concern="@Entry.OverallVisualConcern" />
    </a>
</li>

@code {
    [Parameter, EditorRequired]
    public HistoryEntry Entry { get; set; } = null!;
}
