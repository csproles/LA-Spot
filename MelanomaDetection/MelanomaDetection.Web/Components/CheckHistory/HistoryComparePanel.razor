@* The checks currently picked for comparison, side by side with their scores. *@

<div class="card-panel compare-panel">
    <h2 class="panel-title">Comparing @Entries.Count @(Entries.Count == 1 ? "entry" : "entries")</h2>
    <div class="compare-grid">
        @foreach (var entry in Entries)
        {
            <div class="compare-item">
                <img src="@ImageData.PngUrl(entry.Thumbnail)" alt="Comparison thumbnail" class="compare-thumb" />
                <p class="compare-label">@(entry.SpotLabel ?? (string.IsNullOrEmpty(entry.Location) ? "Unfiled" : entry.Location))</p>
                <RiskScoreBadge Score="entry.RiskScore" Concern="@entry.OverallVisualConcern" Format="band" />
                <p class="compare-date">@(entry.ProcessedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "Unknown date")</p>
                <p class="compare-score">Risk score: @entry.RiskScore.ToString("F0")/100</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<HistoryEntry> Entries { get; set; } = Array.Empty<HistoryEntry>();
}
