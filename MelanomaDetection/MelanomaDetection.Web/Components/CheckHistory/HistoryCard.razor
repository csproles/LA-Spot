@* One saved check as a photo card. Tapping it opens the check, or picks it
   for comparison while the grid is in compare mode. *@

<div class="history-card @(Selected ? "history-card-selected" : "")" @onclick="() => OnClick.InvokeAsync(Entry)">
    <div class="history-thumb-wrap">
        <img src="@ImageData.PngUrl(Entry.Thumbnail)" alt="Saved check thumbnail" class="history-thumb" loading="lazy" />
        @if (Selected)
        {
            <span class="history-check-overlay" aria-hidden="true">&#10003;</span>
        }
    </div>
    <div class="history-card-body">
        <div class="history-card-top">
            <span class="history-location">@Title</span>
            <RiskScoreBadge Score="Entry.RiskScore" Concern="@Entry.OverallVisualConcern" Format="band" />
        </div>
        <p class="history-date">@Subtitle</p>
        @if (Entry.NumLesionInstances is > 1)
        {
            <p class="history-note">@Entry.NumLesionInstances.Value spots detected -- only the primary was analyzed.</p>
        }
        @if (!string.IsNullOrWhiteSpace(Entry.Notes))
        {
            <p class="history-note">@Entry.Notes</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public HistoryEntry Entry { get; set; } = null!;

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback<HistoryEntry> OnClick { get; set; }

    private string Title => Entry.SpotLabel
        ?? (string.IsNullOrEmpty(Entry.Location) ? "Unfiled" : Entry.Location);

    private string Subtitle
    {
        get
        {
            var date = Entry.ProcessedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "Unknown date";
            return Entry.SpotLabel is not null ? $"{Entry.Location} · {date}" : date;
        }
    }
}
