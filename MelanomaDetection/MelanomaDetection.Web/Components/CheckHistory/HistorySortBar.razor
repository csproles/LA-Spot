@* Sort field plus a direction flip for the saved-checks grid. *@

<div class="sort-row">
    <span class="sort-label">Sort by</span>
    <SegmentedControl Options="SortOptions" Value="@SortField" ValueChanged="SortFieldChanged"
                      AriaLabel="Sort saved checks by" />
    <button type="button" class="direction-toggle @(Descending ? "" : "is-ascending")"
            title="Reverse sort direction"
            aria-label="@(Descending ? "Sorted newest first. Reverse to oldest first." : "Sorted oldest first. Reverse to newest first.")"
            @onclick="() => DescendingChanged.InvokeAsync(!Descending)">
        <span class="direction-toggle-icon">
            <AppIcon Name="sort" Size="sm" />
        </span>
    </button>
</div>

@code {
    private static readonly SegmentedControl.Option[] SortOptions =
    {
        new("Date", "Date"),
        new("Location", "Location"),
    };

    [Parameter, EditorRequired]
    public string SortField { get; set; } = "Date";

    [Parameter]
    public EventCallback<string> SortFieldChanged { get; set; }

    [Parameter]
    public bool Descending { get; set; } = true;

    [Parameter]
    public EventCallback<bool> DescendingChanged { get; set; }
}
