@* Inline-SVG trend of a spot's risk scores, oldest to newest. Bands are drawn as
   faint background stripes so a line crossing from "low" into "moderate" is
   visible without a legend. Renders nothing for fewer than two points. *@
@using MelanomaDetection.Web.Services

@if (Scores.Count >= 2)
{
    <svg class="sparkline" viewBox="0 0 @Width @Height" preserveAspectRatio="none" role="img" aria-label="@AriaLabel">
        <rect x="0" y="@YFor(100)" width="@Width" height="@(YFor(RiskBands.ModerateMax) - YFor(100))" class="sparkline-band-high" />
        <rect x="0" y="@YFor(RiskBands.ModerateMax)" width="@Width" height="@(YFor(RiskBands.LowMax) - YFor(RiskBands.ModerateMax))" class="sparkline-band-moderate" />
        <rect x="0" y="@YFor(RiskBands.LowMax)" width="@Width" height="@(YFor(0) - YFor(RiskBands.LowMax))" class="sparkline-band-low" />
        <polyline points="@Points" class="sparkline-line" />
        @for (var i = 0; i < Scores.Count; i++)
        {
            <circle cx="@XFor(i)" cy="@YFor(Scores[i])" r="@(i == Scores.Count - 1 ? 3.5 : 2.2)"
                    class="sparkline-point sparkline-point-@RiskBands.Band(Scores[i]) @(i == Scores.Count - 1 ? "is-latest" : "")" />
        }
    </svg>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<double> Scores { get; set; } = Array.Empty<double>();

    [Parameter]
    public int Width { get; set; } = 160;

    [Parameter]
    public int Height { get; set; } = 44;

    private const double Pad = 4;

    private double XFor(int index) =>
        Scores.Count == 1 ? Width / 2.0 : Pad + index * (Width - 2 * Pad) / (Scores.Count - 1.0);

    private double YFor(double score) =>
        Pad + (100 - Math.Clamp(score, 0, 100)) / 100.0 * (Height - 2 * Pad);

    private string Points => string.Join(" ",
        Scores.Select((score, i) => $"{XFor(i):F1},{YFor(score):F1}"));

    private string AriaLabel =>
        $"Risk trend across {Scores.Count} checks, from {Scores[0]:F0} to {Scores[^1]:F0} out of 100";
}
