@* The chat widget: a bottom-right launcher shown on every page (mounted once in
   MainLayout). Opening it renders a panel as a flex sibling of <main> -- at the
   layout's own 860px+ breakpoint that pushes the page content over rather than
   sitting on top of it; below it, ChatWidget.razor.css switches the same panel
   to a full-screen sheet instead, since there's no room to push sideways.

   Declares its own render mode: pages opt into InteractiveServer individually,
   and this has to be clickable even on a statically-rendered page. *@
@rendermode InteractiveServer
@inject ChatService ChatService

<button type="button"
        class="chat-launcher @(IsOpen ? "chat-launcher-hidden" : "")"
        title="Ask about the textbook"
        aria-expanded="@(IsOpen ? "true" : "false")"
        @onclick="Toggle">
    <AppIcon Name="chat" Size="inherit" />
</button>

<aside class="chat-panel-slot @(IsOpen ? "open" : "")">
    @if (IsOpen)
    {
        <ChatPanel Messages="Messages"
                   IsSending="IsSending"
                   SendError="@SendError"
                   OnSend="SendAsync"
                   OnClose="Close" />
    }
</aside>

@code {
    private bool IsOpen;
    private bool IsSending;
    private string? SendError;
    private readonly List<ChatMessage> Messages = new();

    private void Toggle() => IsOpen = !IsOpen;

    private void Close() => IsOpen = false;

    private async Task SendAsync(string question)
    {
        SendError = null;
        Messages.Add(new ChatMessage { Role = ChatRole.User, Text = question });
        IsSending = true;
        StateHasChanged();

        try
        {
            var result = await ChatService.AskAsync(question, Messages);
            Messages.Add(new ChatMessage
            {
                Role = ChatRole.Assistant,
                Text = result.Refused
                    ? (result.RefusalReason ?? "I can't answer that from the textbook.")
                    : (result.Answer ?? string.Empty),
                Refused = result.Refused,
                Sources = result.Sources,
            });
        }
        catch (ChatApiException ex)
        {
            SendError = ex.Message;
        }
        finally
        {
            IsSending = false;
        }
    }
}
