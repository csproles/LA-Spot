@* Chrome for the chat panel: header, scrolling message list, and the input
   pinned to the bottom. Rendered by ChatWidget inside its push/overlay slot. *@

<div class="chat-panel">
    <header class="chat-panel-header">
        <h2 class="chat-panel-title">Ask about the textbook</h2>
        <button type="button" class="chat-panel-close" title="Close chat" @onclick="OnClose">
            <AppIcon Name="close" Size="inherit" />
        </button>
    </header>

    <ChatMessageList Messages="Messages" IsSending="IsSending" OnSuggestion="OnSend" />

    <ErrorAlert Message="@SendError" />

    <ChatInput Disabled="IsSending" OnSend="OnSend" />
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ChatMessage> Messages { get; set; } = Array.Empty<ChatMessage>();

    [Parameter]
    public bool IsSending { get; set; }

    [Parameter]
    public string? SendError { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnSend { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }
}
