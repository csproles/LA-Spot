@* Textarea + send button. Enter submits; Shift+Enter inserts a newline. *@

<div class="chat-input">
    <textarea class="chat-input-textarea"
              placeholder="Ask a question..."
              maxlength="@InputLimits.ChatQuestionMax"
              disabled="@Disabled"
              @bind="Draft"
              @bind:event="oninput"
              @onkeydown="HandleKeyDown"></textarea>
    <button type="button"
            class="chat-input-send"
            title="Send"
            disabled="@(Disabled || string.IsNullOrWhiteSpace(Draft))"
            @onclick="Submit">
        <AppIcon Name="send" Size="inherit" />
    </button>
</div>

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnSend { get; set; }

    private string Draft = string.Empty;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Submit();
        }
    }

    private async Task Submit()
    {
        var question = Draft.Trim();
        if (Disabled || string.IsNullOrEmpty(question))
        {
            return;
        }

        // Cleared before the (possibly slow) send completes -- this also overwrites,
        // on the next render, any newline the browser's default Enter behaviour
        // inserted into the textarea before this handler ran.
        Draft = string.Empty;
        await OnSend.InvokeAsync(question);
    }
}
