@* Which way a spot's risk score has moved since the previous check. Null
   until there are two checks to compare. *@

@if (Trend is not null)
{
    <span class="trend trend-@Trend" title="@Title" role="img" aria-label="@Label">
        <AppIcon Name="@IconName" Size="inherit" StrokeWidth="2.4" />
    </span>
}

@code {
    /// <summary>"up", "down", "flat", or null.</summary>
    [Parameter]
    public string? Trend { get; set; }

    [Parameter]
    public string Title { get; set; } = "Risk trend since previous check";

    private string IconName => Trend switch
    {
        "up" => "arrow-up",
        "down" => "arrow-down",
        _ => "minus",
    };

    // Said in words, so a screen reader hears "Risk trend since previous check: lower" rather than a triangle glyph.
    private string Label => $"{Title}: {(Trend switch { "up" => "higher", "down" => "lower", _ => "unchanged" })}";
}
