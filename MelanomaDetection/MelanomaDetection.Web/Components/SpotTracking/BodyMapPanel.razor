@* The body map in a panel, with the per-region counts and risk bands derived
   from whatever spot list it is given. Both the dashboard and the spots page
   show the same diagram; only the title, the footer and what a tap does
   differ. *@

<section class="card-panel body-map-panel">
    <SectionHeader Title="@Title" Trailing="@Trailing" />

    @if (IsLoading)
    {
        <LoadingRegion Label="Loading your body map">
            <div class="body-map-skeleton">
                <SkeletonBlock Width="140px" Height="220px" Shape="card" Tone="media" />
                <SkeletonBlock Width="88px" Height="26px" Shape="pill" />
            </div>
        </LoadingRegion>
    }
    else
    {
        <BodyMap SelectedRegion="@SelectedRegion"
                 SelectedRegionChanged="SelectedRegionChanged"
                 RegionCounts="RegionCounts"
                 RegionBands="RegionBands"
                 ShowRegionList="ShowRegionList" />
    }

    @if (Footer is not null)
    {
        <div class="body-map-panel-footer">@Footer</div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<Spot> Spots { get; set; } = Array.Empty<Spot>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? SelectedRegion { get; set; }

    [Parameter]
    public EventCallback<string> SelectedRegionChanged { get; set; }

    [Parameter]
    public bool ShowRegionList { get; set; }

    [Parameter]
    public RenderFragment? Trailing { get; set; }

    /// <summary>The hint or filter-clearing control under the diagram.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    private Dictionary<string, int> RegionCounts => Spots
        .GroupBy(spot => spot.BodyRegion)
        .ToDictionary(group => group.Key, group => group.Count());

    private Dictionary<string, string> RegionBands => Spots
        .Where(spot => spot.LastRiskScore is not null)
        .GroupBy(spot => spot.BodyRegion)
        .ToDictionary(group => group.Key, group => RiskBands.Band(group.Max(spot => spot.LastRiskScore)));
}
