@* Front/back body diagram with one tappable dot per region. Used to pick a
   region when creating a spot and, with RegionCounts/RegionBands, to show
   where tracked spots are and how risky the worst one in each region is. *@

<div class="body-map">
    <div class="body-diagram-wrap">
        <div class="body-diagram @(IsBackView ? "is-back" : "")">
            <div class="body-head">
                @if (!IsBackView)
                {
                    <svg class="body-face" viewBox="0 0 34 34" aria-hidden="true">
                        <circle cx="12" cy="14" r="2" fill="var(--color-navy)" />
                        <circle cx="22" cy="14" r="2" fill="var(--color-navy)" />
                        <path d="M10 20c1.8 2.6 4.4 3.6 7 3.6s5.2-1 7-3.6" stroke="var(--color-navy)" stroke-width="2" fill="none" stroke-linecap="round" />
                    </svg>
                }
            </div>
            <div class="body-torso"></div>
            <div class="body-arm body-arm-left"></div>
            <div class="body-arm body-arm-right"></div>
            <div class="body-leg body-leg-left"></div>
            <div class="body-leg body-leg-right"></div>

            @foreach (var region in Regions)
            {
                var count = CountFor(region.Name);
                var band = BandFor(region.Name);
                <button type="button"
                        class="@DotClass(region.Name, count, band)"
                        style="@DotStyle(region)"
                        @onclick="() => Select(region.Name)"
                        aria-label="@DotLabel(region.Name, count)">
                    @if (count > 0)
                    {
                        <span class="body-dot-count">@count</span>
                    }
                </button>
            }
        </div>
        <div class="body-toggle-row">
            <button type="button" class="btn btn-outline-primary btn-sm body-toggle" @onclick="() => IsBackView = !IsBackView">
                @(IsBackView ? "Back view" : "Front view")
            </button>
            <InfoPopover Title="What front view and back view mean" Label="What is this?">
                <p><strong>Front view</strong> is your body as you see it facing a mirror: your face, chest, belly, and the front of your arms and legs.</p>
                <p><strong>Back view</strong> is your body as someone standing behind you sees it: the back of your head and neck, your upper and lower back, and the back of your arms and legs.</p>
                <p>Press the <strong>Front view</strong> or <strong>Back view</strong> button to switch sides. The dots mark the same seven regions on both sides, so "Chest/Upper Back" is your chest on the front view and your upper back on the back view. "Abdomen/Lower Back" works the same way.</p>
                <p>Pick the side where the spot is easiest to place, then tap the dot on that part of the body.</p>
            </InfoPopover>
        </div>
    </div>

    @if (ShowRegionList)
    {
        <div class="body-location-list">
            @foreach (var region in Regions)
            {
                var count = CountFor(region.Name);
                <button type="button"
                        class="region-button @(IsSelected(region.Name) ? "region-button-selected" : "")"
                        @onclick="() => Select(region.Name)">
                    @region.Name
                    @if (count > 0)
                    {
                        <span class="region-count">@count</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    public record Region(string Name, double Top, double Left);

    /// <summary>The seven regions a spot can be filed under, with their dot positions.</summary>
    public static readonly IReadOnlyList<Region> Regions = new[]
    {
        new Region("Head/Neck", 7.7, 50),
        new Region("Chest/Upper Back", 25.5, 50),
        new Region("Abdomen/Lower Back", 49, 50),
        new Region("Left Arm", 37.7, 15.7),
        new Region("Right Arm", 37.7, 84.3),
        new Region("Left Leg", 79, 35.7),
        new Region("Right Leg", 79, 64.3),
    };

    [Parameter]
    public string? SelectedRegion { get; set; }

    [Parameter]
    public EventCallback<string> SelectedRegionChanged { get; set; }

    /// <summary>Tracked spots per region, shown as a badge on the dot.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, int>? RegionCounts { get; set; }

    /// <summary>Worst risk band per region ("low"/"moderate"/"high"), used to colour the dot.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? RegionBands { get; set; }

    [Parameter]
    public bool ShowRegionList { get; set; } = true;

    private bool IsBackView;

    private bool IsSelected(string region) => SelectedRegion == region;

    private string DotClass(string region, int count, string? band)
    {
        var classes = new List<string> { "body-dot" };
        if (IsSelected(region)) classes.Add("body-dot-selected");
        if (band is not null) classes.Add($"body-dot-{band}");
        if (count > 0) classes.Add("body-dot-tracked");
        return string.Join(" ", classes);
    }

    private static string DotStyle(Region region) =>
        $"top:{region.Top.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;left:{region.Left.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private static string DotLabel(string region, int count) =>
        count > 0 ? $"{region}, {count} tracked" : region;

    private int CountFor(string region) =>
        RegionCounts is not null && RegionCounts.TryGetValue(region, out var count) ? count : 0;

    private string? BandFor(string region) =>
        RegionBands is not null && RegionBands.TryGetValue(region, out var band) ? band : null;

    private async Task Select(string region)
    {
        SelectedRegion = region;
        await SelectedRegionChanged.InvokeAsync(region);
    }
}
