@* One tracked spot as a tappable row: label, region, latest risk, trend and
   recheck status. Used by the dashboard, the spot list and the check flow. *@
@inject NavigationManager NavigationManager

<button type="button" class="spot-card @(Selected ? "spot-card-selected" : "")" @onclick="HandleClick">
    <div class="spot-card-main">
        <div class="spot-card-heading">
            <span class="spot-card-label">@Spot.Label</span>
            @if (Spot.LastRiskScore is not null)
            {
                <RiskScoreBadge Score="Spot.LastRiskScore" Concern="@Spot.LastOverallVisualConcern" Format="band-score" />
            }
        </div>
        <p class="spot-card-meta">@MetaLine</p>
        <span class="spot-card-status">
            <RecheckBadge Spot="Spot" />
        </span>
    </div>

    <div class="spot-card-side">
        <TrendArrow Trend="@Spot.Trend" />
        <span class="spot-card-chevron">
            <AppIcon Name="chevron-right" Size="md" />
        </span>
    </div>
</button>

@code {
    [Parameter, EditorRequired]
    public Spot Spot { get; set; } = null!;

    /// <summary>When set, the card calls this instead of navigating to the spot's page.</summary>
    [Parameter]
    public EventCallback<Spot> OnSelect { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    private string MetaLine => Spot.CheckCount > 0
        ? $"{Spot.BodyRegion} · {Spot.CheckCount} {(Spot.CheckCount == 1 ? "check" : "checks")} · last {Recheck.Ago(Spot.LastCheckedAt)}"
        : $"{Spot.BodyRegion} · not photographed yet";

    private async Task HandleClick()
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(Spot);
        }
        else
        {
            NavigationManager.NavigateTo($"/spots/{Spot.Id}");
        }
    }
}
