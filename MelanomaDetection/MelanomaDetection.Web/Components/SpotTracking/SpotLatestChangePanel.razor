@* The two most recent photos of this spot next to each other, with the
   numbers that moved between them. *@

<section class="card-panel">
    <h2 class="panel-title">Latest change</h2>

    @if (Checks.Count >= 2)
    {
        <PhotoComparisonPair BeforeBase64="@Previous.Thumbnail" BeforeCaption="@DateOf(Previous)"
                             AfterBase64="@Latest.Thumbnail" AfterCaption="@DateOf(Latest)" />

        <dl class="change-stats">
            <div class="change-stat">
                <dt class="change-stat-name">Risk score</dt>
                <dd class="change-stat-value">@Previous.RiskScore.ToString("F0") → @Latest.RiskScore.ToString("F0")</dd>
            </div>
            <div class="change-stat">
                <dt class="change-stat-name">Diameter</dt>
                <dd class="change-stat-value">@DiameterOf(Previous) → @DiameterOf(Latest)</dd>
            </div>
            <div class="change-stat">
                <dt class="change-stat-name">Colour variation</dt>
                <dd class="change-stat-value">@ScoreOf(Previous.Color) → @ScoreOf(Latest.Color)</dd>
            </div>
        </dl>

        <a href="/results/@Latest.ProcessingId" class="link-button">See the full change analysis</a>
    }
    else
    {
        <p class="text-muted-small">
            After your next photo of this spot, this panel shows what changed: size,
            shape, colour, and the overall risk score side by side.
        </p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<LASpot> Checks { get; set; } = Array.Empty<LASpot>();

    private LASpot Latest => Checks[^1];

    private LASpot Previous => Checks[^2];

    private static string DateOf(LASpot check) =>
        check.ProcessedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "Unknown date";

    private static string DiameterOf(LASpot check) =>
        check.DiameterMm is null ? "size n/a" : $"≈{check.DiameterMm:F1} mm";

    private static string ScoreOf(double? score) =>
        score is null ? "n/a" : $"{score:F1}/10";
}
