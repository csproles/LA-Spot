@* A risk score as a coloured pill. When a check's own overall_visual_concern
   is known, IT decides the colour and word -- never a band cut on Score --
   so a check the results page calls "Elevated" can never show as "Low"
   here. RiskBands is used only as a fallback for a check saved before this
   field existed (Concern is null), never to override or reinterpret a
   check's own authoritative result. *@

<span class="risk-badge risk-badge-@Band">@Text</span>

@code {
    [Parameter, EditorRequired]
    public double? Score { get; set; }

    /// <summary>This check's own "LOWER VISUAL CONCERN" / "ELEVATED VISUAL
    /// CONCERN" / "NO_DETECTION" result, when known. Authoritative whenever
    /// it's set -- see Services/VisualConcern.cs.</summary>
    [Parameter]
    public string? Concern { get; set; }

    /// <summary>
    /// "score" -> 62, "band" -> Elevated, "band-score" -> Elevated · 62,
    /// "detail" -> Elevated concern · 62/100.
    /// </summary>
    [Parameter]
    public string Format { get; set; } = "score";

    /// <summary>CSS tone: the check's own concern when known; RiskBands'
    /// legacy band only as a fallback for a pre-V4 check with no concern at
    /// all (Concern is null, not NO_DETECTION -- that already has its own
    /// "muted" tone via VisualConcern.CssTone).</summary>
    private string Band => Concern is not null ? VisualConcern.CssTone(Concern) : RiskBands.Band(Score);

    private string ShortWord => Concern is not null ? VisualConcern.ShortLabel(Concern) : RiskBands.ShortLabel(Band);

    private string Text => Format switch
    {
        "band" => ShortWord,
        "band-score" => $"{ShortWord} · {Score:F0}",
        "detail" => $"{ShortWord} concern · {Score:F0}/100",
        _ => $"{Score:F0}",
    };
}
