@* How overdue a spot is for its next photo. Renders nothing for a spot that
   has never been photographed, since there is no cadence to be late against. *@

@if (Status.Text is not null)
{
    <span class="due-badge due-badge-@Status.Tone">@Status.Text</span>
}

@code {
    [Parameter, EditorRequired]
    public Spot Spot { get; set; } = null!;

    private Recheck.Status Status => Recheck.StatusOf(Spot);
}
