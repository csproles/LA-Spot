# Secrets — never commit real keys
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS/editor cruft
.DS_Store
.vscode/

# Claude
CLAUDE.md

# melanoma_pipeline/ (hybrid CNN+ABCD multimodal pipeline): never commit the
# dataset itself, the YOLO checkpoint (large binary, obtained separately --
# see melanoma_pipeline/README.md "External assets"), generated
# checkpoints/embeddings/trained models, or any other run output -- these
# are large, regenerable from the code + external assets documented in the
# README, and specific to whoever ran the pipeline on whichever device.
melanoma_pipeline/data/
melanoma_pipeline/outputs/
melanoma_pipeline/weights/*
!melanoma_pipeline/weights/.gitkeep
melanoma_pipeline/.venv/
melanoma_pipeline/venv/
